# garage-init — one-shot bootstrap container that registers the S3 access key
# generated by aura-secrets with the running garage daemon and grants it
# permissions on the aura-artifacts bucket.
#
# Why a custom image: the upstream dxflrs/garage image is FROM scratch (no
# shell, no coreutils), so a bootstrap script cannot run inside it. This
# image is alpine + the garage CLI binary copied from the same upstream tag,
# so the CLI talks to the daemon via the exact RPC protocol it was built for.
#
# Compose dependency chain:
#   garage-init.depends_on.garage = service_started
#   aura.depends_on.garage-init   = service_completed_successfully
#
# The script itself is mounted at /scripts/garage-init.sh from the repo so
# changes take effect without rebuilding the image.
FROM alpine:3.21

COPY --from=dxflrs/garage:v2.3.0 /garage /usr/local/bin/garage

# garage CLI reads /etc/garage.toml by default; compose mounts the generated
# toml at that path so rpc_secret + rpc_public_addr come from a single source.
ENTRYPOINT ["/bin/sh", "/scripts/garage-init.sh"]
