@@ -0,0 +1,190 @@
+//! The `postMessage` bridge to a same-origin parent page (`?host=parent`), for pages that embed
+//! DeckCraft in an `<iframe>`. It speaks GridCraft's and PdfCraft's protocol, with the
+//! `deckcraft:` prefix. Messages are plain objects with a `type`:
+//!
+//! - `deckcraft:ready` (to the parent): `{ version }`, the app is listening; send a file now.
+//! - `deckcraft:open` (from the parent): `{ name, bytes }`, bytes an `ArrayBuffer` or
+//!   `Uint8Array`. It opens like a presentation picked with File › Open.
+//! - `deckcraft:save` (to the parent): `{ name, bytes }` (a transferred `ArrayBuffer`) for every
+//!   file DeckCraft would otherwise download: Save, Save As, Export and Print. A Save of a deck
+//!   the parent sent as `.pptx` comes back as `.pptx`, not as DeckCraft's own `.deckcraft`.
+//! - `deckcraft:dirty` (to the parent): `{ dirty }` whenever unsaved changes appear or go away.
+//! - `deckcraft:failed` (to the parent): `{ error }` when the app couldn't start.
+//!
+//! Only the parent window on the page's own origin is heard or answered.
+
+use std::cell::{Cell, RefCell};
+use std::collections::HashSet;
+use std::rc::Rc;
+
+use deckcraft_ui_egui::{Services, SlideApp};
+use wasm_bindgen::JsCast as _;
+use wasm_bindgen::JsValue;
+use wasm_bindgen::closure::Closure;
+
+/// Saving one of these hands the whole deck to the parent: the deck counts as saved.
+const DECK_EXTS: &[&str] = &["deckcraft", "pptx"];
+
+#[derive(Clone)]
+pub struct Bridge {
+    window: web_sys::Window,
+    parent: web_sys::Window,
+    origin: String,
+    /// Files the parent sent that the app hasn't been handed yet.
+    arrived: Rc<RefCell<Vec<(String, Vec<u8>)>>>,
+    /// Stems of the decks the parent sent as `.pptx`.
+    pptx: Rc<RefCell<HashSet<String>>>,
+    /// Names of the files handed to the parent since the last frame.
+    saved: Rc<RefCell<Vec<String>>>,
+    /// The unsaved-changes state last reported to the parent.
+    reported: Rc<Cell<Option<bool>>>,
+}
+
+impl Bridge {
+    /// `None` when the page isn't framed (there is no parent to talk to).
+    pub fn new() -> Option<Self> {
+        let window = web_sys::window()?;
+        let parent = window.parent().ok().flatten()?;
+        if js_sys::Object::is(&parent, &window) {
+            return None;
+        }
+        let origin = window.location().origin().ok()?;
+        Some(Self {
+            window,
+            parent,
+            origin,
+            arrived: Rc::default(),
+            pptx: Rc::default(),
+            saved: Rc::default(),
+            reported: Rc::default(),
+        })
+    }
+
+    /// Send saved and exported files to the parent instead of downloading them, and hear files
+    /// from it.
+    pub fn connect(&self, services: &mut Services, ctx: egui::Context) {
+        self.listen(ctx);
+        let bridge = self.clone();
+        services.download = Some(Box::new(move |name: &str, bytes: &[u8]| {
+            if let Err(e) = bridge.post_save(name, bytes) {
+                log::error!("couldn't hand {name} to the page: {e}");
+            }
+        }));
+    }
+
+    pub fn post_ready(&self) {
+        self.send(&[("type", "deckcraft:ready".into()), ("version", env!("CARGO_PKG_VERSION").into())]);
+    }
+
+    pub fn post_failed(&self, error: &str) {
+        self.send(&[("type", "deckcraft:failed".into()), ("error", error.into())]);
+    }
+
+    /// The files the parent sent since the last frame. The app opens them only under a request
+    /// id of its own, which the caller takes for each.
+    pub fn take_arrived(&self) -> Vec<(String, Vec<u8>)> {
+        std::mem::take(&mut *self.arrived.borrow_mut())
+    }
+
+    /// After each frame: a deck handed to the parent this frame counts as saved, and the parent
+    /// hears when unsaved changes appear or go away. The Close prompt's Save closes the deck in
+    /// the same frame, so only an active deck of the saved name is marked.
+    pub fn sync(&self, app: &mut SlideApp) {
+        let saved = std::mem::take(&mut *self.saved.borrow_mut());
+        if let Some(stem) = saved.iter().rev().find_map(|name| deck_stem(name))
+            && let Some(doc) = app.session.active_mut()
+            && doc.title() == stem
+        {
+            doc.saved_doc = doc.doc.clone();
+            doc.revision += 1;
+        }
+        let dirty = app.session.documents().iter().any(|d| d.is_dirty());
+        if self.reported.get() != Some(dirty) && self.send(&[("type", "deckcraft:dirty".into()), ("dirty", dirty.into())]) {
+            self.reported.set(Some(dirty));
+        }
+    }
+
+    fn post_save(&self, path: &str, bytes: &[u8]) -> Result<(), String> {
+        let name = std::path::Path::new(path).file_name().map(|n| n.to_string_lossy().to_string()).unwrap_or_else(|| path.to_string());
+        let (name, bytes) = match name.strip_suffix(".deckcraft") {
+            Some(stem) if self.pptx.borrow().contains(stem) => {
+                let (doc, _) = deckcraft_engine::cmd::file::open_checked(&name, bytes).map_err(|e| e.to_string())?;
+                let pptx = deckcraft_engine::cmd::file::save_bytes(&doc, "pptx").map_err(|e| e.to_string())?;
+                (format!("{stem}.pptx"), pptx)
+            }
+            _ => (name, bytes.to_vec()),
+        };
+        let buffer = js_sys::Uint8Array::from(bytes.as_slice()).buffer();
+        let message = message(&[("type", "deckcraft:save".into()), ("name", name.as_str().into()), ("bytes", buffer.clone().into())])
+            .ok_or_else(|| "couldn't build the message".to_string())?;
+        self.parent
+            .post_message_with_transfer(&message, &self.origin, &js_sys::Array::of1(&buffer))
+            .map_err(|e| e.as_string().unwrap_or_else(|| format!("{e:?}")))?;
+        self.saved.borrow_mut().push(name);
+        Ok(())
+    }
+
+    fn listen(&self, ctx: egui::Context) {
+        let parent = self.parent.clone();
+        let origin = self.origin.clone();
+        let arrived = self.arrived.clone();
+        let pptx = self.pptx.clone();
+        let on_message = Closure::<dyn FnMut(web_sys::MessageEvent)>::new(move |event: web_sys::MessageEvent| {
+            if event.origin() != origin || !event.source().is_some_and(|s| js_sys::Object::is(&s, &parent)) {
+                return;
+            }
+            let data = event.data();
+            if string(&data, "type").as_deref() != Some("deckcraft:open") {
+                return;
+            }
+            let name = string(&data, "name").filter(|n| !n.trim().is_empty()).unwrap_or_else(|| "Presentation.pptx".to_string());
+            let Some(bytes) = bytes(&data) else { return };
+            if let Some((stem, ext)) = name.rsplit_once('.')
+                && ext.eq_ignore_ascii_case("pptx")
+            {
+                pptx.borrow_mut().insert(stem.to_string());
+            }
+            arrived.borrow_mut().push((name, bytes));
+            ctx.request_repaint();
+        });
+        if self.window.add_event_listener_with_callback("message", on_message.as_ref().unchecked_ref()).is_ok() {
+            // The listener lives as long as the page.
+            on_message.forget();
+        }
+    }
+
+    /// Post a message to the parent; false if it couldn't be sent.
+    fn send(&self, fields: &[(&str, JsValue)]) -> bool {
+        message(fields).is_some_and(|m| self.parent.post_message(&m, &self.origin).is_ok())
+    }
+}
+
+/// The deck's title a whole-deck save carries, `None` for an export.
+fn deck_stem(name: &str) -> Option<&str> {
+    let (stem, ext) = name.rsplit_once('.')?;
+    DECK_EXTS.iter().any(|e| ext.eq_ignore_ascii_case(e)).then_some(stem)
+}
+
+fn message(fields: &[(&str, JsValue)]) -> Option<js_sys::Object> {
+    let m = js_sys::Object::new();
+    for (key, value) in fields {
+        js_sys::Reflect::set(&m, &JsValue::from_str(key), value).ok()?;
+    }
+    Some(m)
+}
+
+fn string(data: &JsValue, key: &str) -> Option<String> {
+    js_sys::Reflect::get(data, &JsValue::from_str(key)).ok()?.as_string()
+}
+
+/// `bytes` as an `ArrayBuffer` or `Uint8Array`.
+fn bytes(data: &JsValue) -> Option<Vec<u8>> {
+    let bytes = js_sys::Reflect::get(data, &JsValue::from_str("bytes")).ok()?;
+    if let Some(array) = bytes.dyn_ref::<js_sys::Uint8Array>() {
+        Some(array.to_vec())
+    } else if bytes.is_instance_of::<js_sys::ArrayBuffer>() {
+        Some(js_sys::Uint8Array::new(&bytes).to_vec())
+    } else {
+        None
+    }
+}
