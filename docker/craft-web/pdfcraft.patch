@@ -464,9 +464,23 @@ fn detect_system_lang() -> Lang {
     let Some(navigator) = web_sys::window().map(|w| w.navigator()) else { return Lang::EN };
     let mut tags: Vec<String> = navigator.languages().iter().take(31).filter_map(|v| v.as_string()).collect();
     tags.extend(navigator.language());
+    // The web build has no face for some languages: Auto skips them rather than draw boxes.
+    tags.retain(|tag| lang_from_tag(tag.trim()).is_some_and(has_face));
     first_supported_tag(&tags).unwrap_or(Lang::EN)
 }
 
+/// Japanese, Chinese, Arabic and Telugu have a face only from craft-fonts, which the web build
+/// is made without ([`crate::theme::font_definitions`]): Auto skips them rather than draw boxes.
+#[cfg(target_arch = "wasm32")]
+fn has_face(lang: Lang) -> bool {
+    match lang.code() {
+        "ja" | "zh-hans" | "zh-hant" => !pdfcraft_fonts::ui_cjk_fonts(false).is_empty(),
+        "ar" => !pdfcraft_fonts::ui_arabic_fonts().is_empty(),
+        "te" => !pdfcraft_fonts::ui_telugu_fonts().is_empty(),
+        _ => true,
+    }
+}
