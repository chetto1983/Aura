diff --git a/apps/photocraft-web/src/host.rs b/apps/photocraft-web/src/host.rs
new file mode 100644
index 00000000..f17c650c
--- /dev/null
+++ b/apps/photocraft-web/src/host.rs
@@ -0,0 +1,146 @@
+//! The `postMessage` bridge to a same-origin parent page (`?host=parent`), for pages that embed
+//! PhotoCraft in an `<iframe>`. It speaks GridCraft's and PdfCraft's protocol, with the
+//! `photocraft:` prefix. Messages are plain objects with a `type`:
+//!
+//! - `photocraft:ready` (to the parent): `{ version }`, the app is listening; send a file now.
+//! - `photocraft:open` (from the parent): `{ name, bytes }`, bytes an `ArrayBuffer` or
+//!   `Uint8Array`. It opens as a file of that name, so File › Save writes it back under it.
+//! - `photocraft:save` (to the parent): `{ name, bytes }` (a transferred `ArrayBuffer`) for every
+//!   file PhotoCraft would otherwise download: Save, Save As, Save a Copy and every Export. The
+//!   parent stores it and reports failures itself.
+//! - `photocraft:dirty` (to the parent): `{ dirty }` whenever unsaved changes appear or go away.
+//! - `photocraft:failed` (to the parent): `{ error }` when the app couldn't start.
+//!
+//! Only the parent window on the page's own origin is heard or answered.
+
+use std::cell::Cell;
+use std::rc::Rc;
+
+use photocraft_ui_egui::{Inbox, PhotocraftApp, Services};
+use wasm_bindgen::JsCast as _;
+use wasm_bindgen::JsValue;
+use wasm_bindgen::closure::Closure;
+
+#[derive(Clone)]
+pub struct Bridge {
+    window: web_sys::Window,
+    parent: web_sys::Window,
+    origin: String,
+    /// Files the parent sent that the app hasn't opened yet.
+    arrived: Inbox,
+    /// The unsaved-changes state last reported to the parent.
+    reported: Rc<Cell<Option<bool>>>,
+}
+
+impl Bridge {
+    /// `None` when the page isn't framed (there is no parent to talk to).
+    pub fn new() -> Option<Self> {
+        let window = web_sys::window()?;
+        let parent = window.parent().ok().flatten()?;
+        if js_sys::Object::is(&parent, &window) {
+            return None;
+        }
+        let origin = window.location().origin().ok()?;
+        Some(Self { window, parent, origin, arrived: Inbox::default(), reported: Rc::default() })
+    }
+
+    /// Send saved and exported files to the parent instead of downloading them, and hear files
+    /// from it. The app counts a Save as done when the parent took the bytes.
+    pub fn connect(&self, services: &mut Services, ctx: egui::Context) {
+        self.listen(ctx);
+        let bridge = self.clone();
+        services.write = Some(Box::new(move |path: &str, bytes: &[u8]| bridge.post_save(path, bytes)));
+        // Unlike a browser download, a save the parent took is confirmed: it marks the document saved.
+        services.write_unconfirmed = false;
+    }
+
+    pub fn post_ready(&self) {
+        self.send(&[("type", "photocraft:ready".into()), ("version", env!("CARGO_PKG_VERSION").into())]);
+    }
+
+    pub fn post_failed(&self, error: &str) {
+        self.send(&[("type", "photocraft:failed".into()), ("error", error.into())]);
+    }
+
+    /// Before each frame: the files the parent sent open under their own names, so a Save
+    /// goes back to the same file rather than through Save As.
+    pub fn open_arrived(&self, app: &mut PhotocraftApp) {
+        let arrived = std::mem::take(&mut *self.arrived.lock().unwrap_or_else(|e| e.into_inner()));
+        for (name, bytes) in arrived {
+            if let Err(e) = app.open_file(&name, &bytes) {
+                app.open_failed(&name, &e);
+            }
+        }
+    }
+
+    /// After each frame: the parent hears when unsaved changes appear or go away. A Save marks
+    /// the document saved by itself once the parent took the bytes.
+    pub fn sync(&self, app: &PhotocraftApp) {
+        let dirty = app.has_unsaved_work();
+        if self.reported.get() != Some(dirty) && self.send(&[("type", "photocraft:dirty".into()), ("dirty", dirty.into())]) {
+            self.reported.set(Some(dirty));
+        }
+    }
+
+    fn post_save(&self, path: &str, bytes: &[u8]) -> Result<(), String> {
+        let name = std::path::Path::new(path).file_name().map(|n| n.to_string_lossy().to_string()).unwrap_or_else(|| path.to_string());
+        let buffer = js_sys::Uint8Array::from(bytes).buffer();
+        let message = message(&[("type", "photocraft:save".into()), ("name", name.as_str().into()), ("bytes", buffer.clone().into())])
+            .ok_or_else(|| "couldn't build the message".to_string())?;
+        self.parent
+            .post_message_with_transfer(&message, &self.origin, &js_sys::Array::of1(&buffer))
+            .map_err(|e| e.as_string().unwrap_or_else(|| format!("{e:?}")))
+    }
+
+    fn listen(&self, ctx: egui::Context) {
+        let parent = self.parent.clone();
+        let origin = self.origin.clone();
+        let arrived = self.arrived.clone();
+        let on_message = Closure::<dyn FnMut(web_sys::MessageEvent)>::new(move |event: web_sys::MessageEvent| {
+            if event.origin() != origin || !event.source().is_some_and(|s| js_sys::Object::is(&s, &parent)) {
+                return;
+            }
+            let data = event.data();
+            if string(&data, "type").as_deref() != Some("photocraft:open") {
+                return;
+            }
+            let name = string(&data, "name").filter(|n| !n.trim().is_empty()).unwrap_or_else(|| "Untitled.png".to_string());
+            let Some(bytes) = bytes(&data) else { return };
+            arrived.lock().unwrap_or_else(|e| e.into_inner()).push((name, bytes));
+            ctx.request_repaint();
+        });
+        if self.window.add_event_listener_with_callback("message", on_message.as_ref().unchecked_ref()).is_ok() {
+            // The listener lives as long as the page.
+            on_message.forget();
+        }
+    }
+
+    /// Post a message to the parent; false if it couldn't be sent.
+    fn send(&self, fields: &[(&str, JsValue)]) -> bool {
+        message(fields).is_some_and(|m| self.parent.post_message(&m, &self.origin).is_ok())
+    }
+}
+
+fn message(fields: &[(&str, JsValue)]) -> Option<js_sys::Object> {
+    let m = js_sys::Object::new();
+    for (key, value) in fields {
+        js_sys::Reflect::set(&m, &JsValue::from_str(key), value).ok()?;
+    }
+    Some(m)
+}
+
+fn string(data: &JsValue, key: &str) -> Option<String> {
+    js_sys::Reflect::get(data, &JsValue::from_str(key)).ok()?.as_string()
+}
+
+/// `bytes` as an `ArrayBuffer` or `Uint8Array`.
+fn bytes(data: &JsValue) -> Option<Vec<u8>> {
+    let bytes = js_sys::Reflect::get(data, &JsValue::from_str("bytes")).ok()?;
+    if let Some(array) = bytes.dyn_ref::<js_sys::Uint8Array>() {
+        Some(array.to_vec())
+    } else if bytes.is_instance_of::<js_sys::ArrayBuffer>() {
+        Some(js_sys::Uint8Array::new(&bytes).to_vec())
+    } else {
+        None
+    }
+}
