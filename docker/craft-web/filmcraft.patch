@@ -0,0 +1,149 @@
+//! The `postMessage` bridge to a same-origin parent page (`?host=parent`), for pages that embed
+//! FilmCraft in an `<iframe>`. It speaks GridCraft's and PdfCraft's protocol, with the
+//! `filmcraft:` prefix. Messages are plain objects with a `type`:
+//!
+//! - `filmcraft:ready` (to the parent): `{ version }`, the app is listening; send a file now.
+//! - `filmcraft:open` (from the parent): `{ name, bytes }`, bytes an `ArrayBuffer` or
+//!   `Uint8Array`. A `.fcproj` opens as a project; any other file is imported and a sequence is
+//!   made from it, so the editor starts on its timeline.
+//! - `filmcraft:save` (to the parent): `{ name, bytes }` (a transferred `ArrayBuffer`) for every
+//!   file FilmCraft would otherwise download: Save, Save As, Save a Copy and every Export. The
+//!   parent stores it and reports failures itself.
+//! - `filmcraft:dirty` (to the parent): `{ dirty }` whenever unsaved changes appear or go away.
+//! - `filmcraft:failed` (to the parent): `{ error }` when the app couldn't start.
+//!
+//! Only the parent window on the page's own origin is heard or answered.
+
+use std::cell::Cell;
+use std::rc::Rc;
+
+use filmcraft_ui_egui::FilmcraftApp;
+use serde_json::{Value, json};
+use wasm_bindgen::JsCast as _;
+use wasm_bindgen::JsValue;
+use wasm_bindgen::closure::Closure;
+
+#[derive(Clone)]
+pub struct Bridge {
+    window: web_sys::Window,
+    parent: web_sys::Window,
+    origin: String,
+    /// The unsaved-changes state last reported to the parent.
+    reported: Rc<Cell<Option<bool>>>,
+}
+
+impl Bridge {
+    /// `None` when the page isn't framed (there is no parent to talk to).
+    pub fn new() -> Option<Self> {
+        let window = web_sys::window()?;
+        let parent = window.parent().ok().flatten()?;
+        if js_sys::Object::is(&parent, &window) {
+            return None;
+        }
+        let origin = window.location().origin().ok()?;
+        Some(Self { window, parent, origin, reported: Rc::default() })
+    }
+
+    /// Send every file FilmCraft writes to the parent instead of downloading it, and hear files
+    /// from it.
+    pub fn connect(&self) {
+        self.listen();
+        let bridge = self.clone();
+        crate::fs::set_on_write(move |path, data| {
+            if let Err(e) = bridge.post_save(path, data) {
+                log::warn!("couldn't hand {path} to the page: {e}");
+            }
+        });
+    }
+
+    pub fn post_ready(&self) {
+        self.send(&[("type", "filmcraft:ready".into()), ("version", env!("CARGO_PKG_VERSION").into())]);
+    }
+
+    pub fn post_failed(&self, error: &str) {
+        self.send(&[("type", "filmcraft:failed".into()), ("error", error.into())]);
+    }
+
+    /// After each frame: the parent hears when unsaved changes appear or go away. Saving the
+    /// project marks it saved by itself; an export leaves it as it was.
+    pub fn sync(&self, app: &FilmcraftApp) {
+        let dirty = app.session.is_dirty();
+        if self.reported.get() != Some(dirty) && self.send(&[("type", "filmcraft:dirty".into()), ("dirty", dirty.into())]) {
+            self.reported.set(Some(dirty));
+        }
+    }
+
+    fn post_save(&self, path: &str, bytes: &[u8]) -> Result<(), String> {
+        let name = std::path::Path::new(path).file_name().map(|n| n.to_string_lossy().to_string()).unwrap_or_else(|| path.to_string());
+        let buffer = js_sys::Uint8Array::from(bytes).buffer();
+        let message = message(&[("type", "filmcraft:save".into()), ("name", name.as_str().into()), ("bytes", buffer.clone().into())])
+            .ok_or_else(|| "couldn't build the message".to_string())?;
+        self.parent
+            .post_message_with_transfer(&message, &self.origin, &js_sys::Array::of1(&buffer))
+            .map_err(|e| e.as_string().unwrap_or_else(|| format!("{e:?}")))
+    }
+
+    fn listen(&self) {
+        let parent = self.parent.clone();
+        let origin = self.origin.clone();
+        let on_message = Closure::<dyn FnMut(web_sys::MessageEvent)>::new(move |event: web_sys::MessageEvent| {
+            if event.origin() != origin || !event.source().is_some_and(|s| js_sys::Object::is(&s, &parent)) {
+                return;
+            }
+            let data = event.data();
+            if string(&data, "type").as_deref() != Some("filmcraft:open") {
+                return;
+            }
+            let name = string(&data, "name").filter(|n| !n.trim().is_empty()).unwrap_or_else(|| "clip.mp4".to_string());
+            let Some(file) = file(&data, &name) else { return };
+            wasm_bindgen_futures::spawn_local(open(name, file));
+        });
+        if self.window.add_event_listener_with_callback("message", on_message.as_ref().unchecked_ref()).is_ok() {
+            // The listener lives as long as the page.
+            on_message.forget();
+        }
+    }
+
+    /// Post a message to the parent; false if it couldn't be sent.
+    fn send(&self, fields: &[(&str, JsValue)]) -> bool {
+        message(fields).is_some_and(|m| self.parent.post_message(&m, &self.origin).is_ok())
+    }
+}
+
+/// A project opens; media is imported, a sequence is made from it and the editor shows it.
+async fn open(name: String, file: web_sys::File) {
+    if name.to_ascii_lowercase().ends_with(".fcproj") {
+        if let Err(e) = crate::import::open_project_file(file).await {
+            crate::post(move |w, _| w.app.status(e));
+        }
+        return;
+    }
+    let imported = crate::import::import_files(vec![file]).await;
+    let Some(item) = imported.get("items").and_then(Value::as_array).and_then(|items| items.first()).cloned() else { return };
+    crate::post(move |w, _| match w.app.session.execute("file.newSequence", json!({"fromItem": item})) {
+        Ok(_) => w.app.ui.mode = filmcraft_ui_egui::state::Mode::Edit,
+        Err(e) => w.app.status(e.to_string()),
+    });
+}
+
+fn message(fields: &[(&str, JsValue)]) -> Option<js_sys::Object> {
+    let m = js_sys::Object::new();
+    for (key, value) in fields {
+        js_sys::Reflect::set(&m, &JsValue::from_str(key), value).ok()?;
+    }
+    Some(m)
+}
+
+fn string(data: &JsValue, key: &str) -> Option<String> {
+    js_sys::Reflect::get(data, &JsValue::from_str(key)).ok()?.as_string()
+}
+
+/// `bytes` (an `ArrayBuffer` or `Uint8Array`) as a `File` of this page, which the import reads
+/// in chunks as it reads a picked one.
+fn file(data: &JsValue, name: &str) -> Option<web_sys::File> {
+    let bytes = js_sys::Reflect::get(data, &JsValue::from_str("bytes")).ok()?;
+    if !bytes.is_instance_of::<js_sys::Uint8Array>() && !bytes.is_instance_of::<js_sys::ArrayBuffer>() {
+        return None;
+    }
+    web_sys::File::new_with_buffer_source_sequence(&js_sys::Array::of1(&bytes), name).ok()
+}
