{
  "mcpServers": {
    "mail": {
      "command": "/usr/local/bin/mail-mcp",
      "env": {
        "MAIL_IMAP_DEFAULT_HOST": "imap.example.com",
        "MAIL_IMAP_DEFAULT_USER": "user@example.com",
        "MAIL_IMAP_DEFAULT_PASS": "app-password-or-oauth-token",
        "MAIL_IMAP_DEFAULT_SECURE": "true"
      }
    },
    "database": {
      "command": "/usr/local/bin/ea-database-server",
      "args": ["/workspace/data/example.db"]
    }
  }
}
