{
  "name": "aura-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@12.0.0",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11 <13"
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "dev": "vite",
    "build": "node tokens/generate-theme.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --type-aware --max-warnings=0 .",
    "lint:contract": "node scripts/lint-contract.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "dup": "npx --yes jscpd@4 src",
    "deadcode": "knip --exclude types,nsTypes,enumMembers,duplicates",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "mutation": "stryker run",
    "mutation:contract": "node scripts/stryker-filter-contract.mjs",
    "contrast": "node scripts/contrast-check.mjs"
  },
  "dependencies": {
    "@assistant-ui/core": "^0.3.30",
    "@assistant-ui/react": "^0.15.30",
    "@assistant-ui/react-markdown": "^0.14.17",
    "@assistant-ui/react-syntax-highlighter": "^0.14.6",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-hover-card": "1.2.1",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@svar-ui/core-locales": "^2.6.1",
    "@svar-ui/filemanager-data-provider": "^2.6.0",
    "@svar-ui/filemanager-store": "^2.6.0",
    "@svar-ui/kanban-locales": "^2.6.0",
    "@svar-ui/react-core": "2.6.1",
    "@svar-ui/react-filemanager": "^2.6.0",
    "@svar-ui/react-grid": "2.7.6",
    "@svar-ui/react-kanban": "^2.6.0",
    "@tanstack/react-query": "^5.104.1",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "assistant-stream": "0.3.53",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cytoscape": "3.34.3",
    "cytoscape-fcose": "2.2.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "^4.14.2",
    "react-router": "^8.4.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "4.5.0",
    "tailwind-merge": "^3.7.0",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/cytoscape-fcose": "2.2.5",
    "@types/hast": "^3.0.4",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "knip": "^6.38.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "patch-package": "8.0.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@svar-ui/react-core": "$@svar-ui/react-core",
    "qs": "6.16.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
