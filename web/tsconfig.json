{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "references": [{ "path": "./tsconfig.node.json" }],
  "include": ["src", "e2e"],
  // Wave-0 RED stub: AppShell.test.tsx imports the not-yet-built ../AppShell
  // (23-02). It is RED at vitest by design; drop this exclude once AppShell.tsx
  // exists so the test rejoins the typecheck gate.
  "exclude": ["src/__tests__/AppShell.test.tsx"]
}
