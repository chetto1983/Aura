{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/api/json.ts",
    "src/chat/artifacts/artifactMeta.ts",
    "src/chat/artifacts/downloadAll.ts",
    "src/chat/voice/speechAdapter.ts",
    "src/chat/voice/dictationAdapter.ts",
    "src/chat/displays/answerSources.ts",
    "src/chat/displays/sourceExplorerData.ts",
    "src/chat/displays/swarmRow.ts",
    "src/chat/displays/tableData.ts",
    "src/graph/graphApi.ts",
    "src/graph/graphIntent.ts",
    "src/graph/SigmaCanvas_reducers.ts",
    "src/governance/governanceApi.ts",
    "src/governance/governanceView.tsx",
    "src/approvals/approvalState.ts",
    "src/onboarding/onboardingApi.ts",
    "src/onboarding/onboardingWizardModel.ts",
    "src/chat/share/RevokeConfirmDialog.tsx",
    "src/chat/share/shareApi.ts",
    "src/chat/share/SharedSection.tsx",
    "src/chat/share/ShareLinkRow.tsx",
    "src/chat/share/ShareModal.tsx",
    "src/chat/share/shareTypes.ts",
    "src/chat/share/shareViewModel.ts",
    "src/chat/share/useThreadShares.ts",
    "src/shell/ShareShell.tsx",
    "src/chat/durationFormat.ts",
    "src/chat/toolSummary.ts",
    "src/chat/toolGrouping.ts",
    "src/conversations/exportConversation.ts",
    "src/audit/auditPairing.ts"
  ],
  "thresholds": { "high": 85, "low": 70, "break": 70 },
  "dryRunTimeoutMinutes": 10,
  "vitest": { "configFile": "vitest.stryker.config.ts" },
  "concurrency": 4,
  "reporters": ["clear-text", "progress"],
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
