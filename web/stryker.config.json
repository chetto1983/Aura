{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/api/json.ts",
    "src/chat/displays/answerSources.ts",
    "src/chat/displays/sourceExplorerData.ts",
    "src/chat/displays/swarmRow.ts",
    "src/chat/displays/tableData.ts",
    "src/graph/graphApi.ts",
    "src/graph/graphIntent.ts",
    "src/graph/SigmaCanvas_reducers.ts",
    "src/governance/governanceApi.ts",
    "src/onboarding/onboardingApi.ts",
    "src/onboarding/onboardingWizardModel.ts"
  ],
  "thresholds": { "high": 85, "low": 70, "break": 70 },
  "concurrency": 4,
  "reporters": ["clear-text", "progress"],
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
