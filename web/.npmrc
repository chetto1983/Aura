engine-strict=true
# npm 12 disabled remote-URL tarball dependencies by default (EALLOWREMOTE). This project
# pins xlsx to the SheetJS CDN tarball (cdn.sheetjs.com/xlsx-0.20.3) because the npm-registry
# xlsx is frozen at 0.18.5 — re-enable it here so `npm ci` resolves under npm 12. `root` is the
# least-privilege value (remote permitted only for root/top-level deps like xlsx, never
# transitive; `true` is not a valid value — the enum is all/none/root). Integrity is unchanged:
# package-lock.json pins the tarball's sha512, and npm 11 already allowed remote, so this only
# preserves the existing supply-chain posture across the 11→12 bump.
allow-remote=root
