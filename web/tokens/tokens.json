  "density": {
    "compact": { "space-unit": "3px", "row-h": "30px", "font-base": "14px" },
    "operator": { "space-unit": "4px", "row-h": "34px", "font-base": "15.5px" },
    "review": { "space-unit": "6px", "row-h": "42px", "font-base": "16px" }
  },
  "radius": { "sm": "8px", "md": "14px", "lg": "20px", "xl": "28px", "pill": "999px" },
  "font": {
    "display": "Fraunces, Georgia, serif",
    "sans": "\"Atkinson Hyperlegible Next\", ui-sans-serif, system-ui, sans-serif",
    "mono": "\"Commit Mono\", ui-monospace, SFMono-Regular, monospace"
  },
  "shadow": {
    "drawer": "0 28px 90px rgb(0 0 0 / 0.28)",
    "popover": "0 18px 44px rgb(0 0 0 / 0.18)",
    "focus": "0 0 0 3px rgb(138 180 248 / 0.32)"
  },
  "motion": {
    "fast": "140ms",
    "base": "220ms",
    "slow": "360ms",
    "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)"
  }
}
