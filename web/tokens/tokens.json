    "review": { "space-unit": "6px", "row-h": "42px", "font-base": "16px" }
  },
  "radius": { "sm": "6px", "md": "10px", "lg": "16px", "xl": "22px", "pill": "999px" },
  "font": {
    "display": "Fraunces, Georgia, serif",
    "sans": "\"Atkinson Hyperlegible Next\", ui-sans-serif, system-ui, sans-serif",
    "mono": "\"Commit Mono\", ui-monospace, SFMono-Regular, monospace"
  },
  "shadow": {
    "drawer": "0 24px 80px rgb(0 0 0 / 0.24)",
    "popover": "0 12px 34px rgb(0 0 0 / 0.16)",
    "focus": "0 0 0 3px rgb(138 180 248 / 0.32)"
  },
  "motion": {
    "fast": "140ms",
    "base": "220ms",
    "slow": "360ms",
    "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)"
  }
}
