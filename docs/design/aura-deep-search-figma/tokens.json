{
  "meta": {
    "name": "Aura Deep Search Elysia-Informed Tokens",
    "created": "2026-06-04",
    "source": "docs/design/aura-deep-search-figma/aura-deep-search-elysia-informed.svg",
    "basis": "weaviate/elysia-frontend and pewdiepie-archdaemon/odysseus source patterns adapted to Aura with Neo4j graph visualization, MCP configuration, skills install governance, and dockable operator tools"
  },
  "color": {
    "background": "#080b0f",
    "app": "#0f141b",
    "shell": "#121820",
    "surface": "#171e27",
    "surfaceRaised": "#1d2631",
    "surfaceSoft": "#202b36",
    "border": "#334150",
    "borderStrong": "#3c4b5b",
    "text": "#f4f7fb",
    "textMuted": "#9ca9b7",
    "textFaint": "#687789",
    "accent": "#64d28b",
    "accentSoft": "#183425",
    "cyan": "#72c9ff",
    "cyanSoft": "#152d3d",
    "tealSoft": "#133436",
    "limeSoft": "#29331b",
    "warning": "#d5963d",
    "warningSoft": "#3b2b15",
    "danger": "#c05262",
    "dangerSoft": "#34191e",
    "graphSource": "#72c9ff",
    "graphClaim": "#64d28b",
    "graphEntity": "#43a6a9",
    "graphAgent": "#a6c85d",
    "graphConflict": "#c05262",
    "graphEdgeDefault": "#4a5a69",
    "graphEdgeSelected": "#64d28b",
    "rail": "#111820",
    "railActive": "#183425",
    "dock": "#10151c",
    "dockChip": "#202b36",
    "commandPalette": "#151c25",
    "jobRunning": "#64d28b",
    "jobWarning": "#d5963d",
    "mcp": "#72c9ff",
    "mcpSoft": "#152d3d",
    "skill": "#d5963d",
    "skillSoft": "#3b2b15",
    "approval": "#c05262",
    "approvalSoft": "#34191e",
    "secretRedacted": "#34191e"
  },
  "radius": {
    "frame": 10,
    "shell": 8,
    "panel": 10,
    "control": 8,
    "chip": 6,
    "composer": 12,
    "mobileShell": 28
  },
  "shell": {
    "primaryModes": ["chat", "tree", "graph", "displays", "settings"],
    "dockableTools": [
      "research",
      "compare",
      "sourceExplorer",
      "logs",
      "theme",
      "runInspector",
      "mcpConfig",
      "skillsInstall",
      "approvalCenter"
    ],
    "settingsSurfaces": ["mcpServers", "skillsLibrary", "approvalQueue", "audit"],
    "densityModes": ["compact", "operator", "review"]
  },
  "governance": {
    "riskTiers": ["safe", "normal", "risky", "destructive"],
    "mcpServerStates": ["enabled", "disabled", "failed", "warning"],
    "skillStates": ["active", "pending", "pendingDelete", "archived", "rejected"],
    "secretDisplay": "redacted-after-save"
  },
  "typography": {
    "fontFamily": "Inter, Segoe UI, Arial, sans-serif",
    "monoFamily": "SFMono-Regular, Consolas, Liberation Mono, monospace",
    "h1": { "size": 28, "lineHeight": 36, "weight": 750 },
    "h2": { "size": 20, "lineHeight": 28, "weight": 720 },
    "h3": { "size": 15, "lineHeight": 22, "weight": 700 },
    "body": { "size": 14, "lineHeight": 20, "weight": 400 },
    "small": { "size": 12, "lineHeight": 18, "weight": 400 },
    "tiny": { "size": 10, "lineHeight": 14, "weight": 500 },
    "label": { "size": 11, "lineHeight": 14, "weight": 700 }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32
  },
  "shadow": {
    "panel": "0 14px 34px rgba(0, 0, 0, 0.38)"
  },
  "motion": {
    "fast": "120ms",
    "normal": "220ms",
    "spring": "400 stiffness / 25 damping",
    "reducedMotion": "replace pulsing and hover-expansion with opacity changes"
  }
}
