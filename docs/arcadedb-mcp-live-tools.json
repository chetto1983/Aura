  {
    "annotations": {
      "idempotentHint": false,
      "readOnlyHint": true
    },
    "description": "Read an entity's facts by walking its edges. Exact and cheap: prefer this whenever the question names an entity, and fall back to memory_search only when it does not.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "entity": {
          "type": "string",
          "description": "the entity to read the facts of, by exact name"
        },
        "predicate": {
          "type": "string",
          "description": "narrow to one relation, e.g. works_for"
        },
        "limit": {
          "type": "integer",
          "description": "how many facts to return; defaults to 20"
        },
        "as_of": {
          "type": "string",
          "description": "RFC3339 instant; the facts valid then rather than now"
        }
      },
      "required": [
        "entity"
      ],
      "additionalProperties": false
    },
