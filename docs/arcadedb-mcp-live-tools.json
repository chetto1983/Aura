  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "readOnlyHint": false
    },
    "description": "Detach a source's support or remove matching facts and orphaned entities. A source-scoped call keeps facts that still have another source. Use this for what was never true -- a probe, a bad extraction, a run written under the wrong identity. For something that STOPPED being true, use memory_upsert_fact with supersedes instead: that closes the fact's window and keeps the past answerable, where this destroys it. Pass dry_run first to see the size of what you are about to remove.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "description": "count what would be removed without removing it",
          "type": "boolean"
        },
        "entity": {
          "description": "remove every fact touching this entity, in either direction, and the entity itself",
          "type": "string"
        },
        "keep_orphan_entities": {
          "description": "keep entities this removal strips of their last fact",
          "type": "boolean"
        },
        "object": {
          "description": "narrow to one object; cannot be used alone",
          "type": "string"
        },
        "predicate": {
          "description": "narrow to one relation; cannot be used alone",
          "type": "string"
        },
        "source": {
          "additionalProperties": false,
          "description": "detach support from this source run; facts with other sources remain",
          "properties": {
            "memory_ids": {
              "description": "message or memory ids supporting this fact",
              "items": {
                "type": "string"
              },
              "type": [
                "null",
                "array"
              ]
            },
            "run_id": {
              "description": "the extraction or operator run supporting this fact",
              "type": "string"
            }
          },
          "required": [
            "run_id"
          ],
          "type": [
            "null",
            "object"
          ]
        },
        "subject": {
          "description": "remove facts with this subject",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "memory_forget",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "description": "true when nothing was actually removed",
          "type": "boolean"
        },
        "entities": {
          "description": "entities removed for having no facts left",
          "type": "integer"
        },
        "facts": {
          "description": "facts affected by source detachment or removal",
          "type": "integer"
        }
      },
      "required": [
        "facts",
        "entities"
      ],
      "type": "object"
    },
    "title": "Forget facts"
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "readOnlyHint": false
    },
    "description": "Fold one entity's facts onto another and remove it, for when the same thing was recorded under two names. Prefer this over memory_forget for a duplicate: forgetting destroys the facts only the duplicate knew. If the target does not exist yet this is a rename.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "description": "the duplicate name; it is removed",
          "type": "string"
        },
        "target": {
          "description": "the name that survives and receives the facts",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "type": "object"
    },
    "name": "memory_merge_entities",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "dropped": {
          "description": "facts discarded because they only linked the two names together",
          "type": "integer"
        },
        "moved": {
          "description": "facts re-pointed onto the surviving entity",
          "type": "integer"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "moved",
        "dropped",
        "target"
      ],
      "type": "object"
    },
    "title": "Merge two entities"
  },
  {
    "annotations": {
      "idempotentHint": false,
      "readOnlyHint": true
    },
    "description": "The single deep-read operation for Aura memory. Semantic mode (the default) can return typed fact and historical-conversation evidence together. Recent, open, and scroll progressively browse bounded conversation windows; reasoning explicitly searches or opens provider-visible traces and is never included by other modes. Weak evidence abstains explicitly.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "anchor_seq": {
          "description": "stable turn sequence used by open and scroll",
          "type": "integer"
        },
        "as_of": {
          "description": "RFC3339 instant; return facts valid then rather than now",
          "type": "string"
        },
        "conversation_id": {
          "description": "stable conversation id used by open and scroll",
          "type": "string"
        },
        "cursor": {
          "description": "opaque cursor returned by an earlier open or scroll call",
          "type": "string"
        },
        "direction": {
          "description": "before or after the stable anchor",
          "enum": [
            "before",
            "after"
          ],
          "type": "string"
        },
        "entity": {
          "description": "exact entity name when known; selects graph traversal in semantic mode",
          "type": "string"
        },
        "limit": {
          "description": "bounded number of evidence records or conversation turns",
          "type": "integer"
        },
        "mode": {
          "description": "semantic (default), recent, open, scroll, or reserved reasoning",
          "enum": [
            "semantic",
            "recent",
            "open",
            "scroll",
            "reasoning"
          ],
          "type": "string"
        },
        "predicate": {
          "description": "optional relation filter used with entity",
          "type": "string"
        },
        "query": {
          "description": "what to recall in natural language; used by semantic mode",
          "type": "string"
        },
        "trace_id": {
          "description": "exact reasoning trace id; used only by explicit reasoning mode",
          "type": "string"
        }
      },
      "type": "object"
    },
