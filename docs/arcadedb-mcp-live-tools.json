          "items": {
            "additionalProperties": false,
            "properties": {
              "facts": {
                "type": "integer"
              },
              "kind": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "facts"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        }
      },
      "required": [
        "entities"
      ],
      "type": "object"
    },
    "title": "List entities"
  },
  {
    "annotations": {
      "idempotentHint": false,
      "readOnlyHint": true
    },
    "description": "Read an entity's facts by walking its edges. Exact and cheap: prefer this whenever the question names an entity, and fall back to memory_search only when it does not.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "description": "RFC3339 instant; the facts valid then rather than now",
          "type": "string"
        },
        "entity": {
          "description": "the entity to read the facts of, by exact name",
          "type": "string"
        },
        "limit": {
          "description": "how many facts to return; defaults to 20",
          "type": "integer"
        },
        "predicate": {
          "description": "narrow to one relation, e.g. works_for",
          "type": "string"
        }
      },
      "required": [
        "entity"
      ],
      "type": "object"
    },
    "name": "memory_facts_about",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "facts": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "fact_key": {
