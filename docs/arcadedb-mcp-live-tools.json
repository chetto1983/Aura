                      "description": "the extraction or operator run supporting this fact",
                      "type": "string"
                    }
                  },
                  "required": [
                    "run_id"
                  ],
                  "type": "object"
                },
                "type": [
                  "null",
                  "array"
                ]
              },
              "statement": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "subject_kind": {
                "type": "string"
              },
              "valid_from": {
                "type": "string"
              },
              "valid_to": {
                "description": "absent while the fact still holds",
                "type": "string"
              }
            },
            "required": [
              "statement",
              "predicate",
              "subject",
              "object",
              "sources"
