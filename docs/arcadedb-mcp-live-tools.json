                "type": "string"
              },
              "predicate": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "object": {
                "type": "string"
              },
              "valid_from": {
                "type": "string"
              },
              "valid_to": {
                "type": "string",
                "description": "absent while the fact still holds"
              },
              "source_run_id": {
                "type": "string"
              },
              "source_memory_ids": {
                "type": [
                  "null",
                  "array"
                ],
