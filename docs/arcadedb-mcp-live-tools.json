          "type": "string",
          "description": "human-readable name, used when citing a passage"
        },
        "text": {
          "type": "string",
          "description": "the document's text, already converted to markdown or plain text"
        },
        "source": {
          "type": "string",
          "description": "where it came from, e.g. the original filename"
        },
        "chunk_runes": {
          "type": "integer",
          "description": "target chunk size in characters; defaults to 1200"
        }
      },
      "required": [
        "id",
        "title",
        "text"
      ],
      "additionalProperties": false
    },
    "name": "document_ingest",
    "outputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "chunks": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "chunks"
      ],
      "additionalProperties": false
    },
    "title": "Ingest a document"
  },
  {
