  {
    "annotations": {
      "idempotentHint": false,
      "readOnlyHint": true
    },
    "description": "Return the whole memory as a compact index, one line per entity, meant to be READ ONCE AND KEPT rather than queried repeatedly. While it fits in context, searching is unnecessary: measured on a real 158-note memory, full-text search found the right note at rank 1 in 6 cases out of 10 and the index in 10 out of 10. Check `covered`: when it is false the memory is larger than the index and memory_search is still needed for what was left out.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "facts_per_entity": {
          "description": "how many facts to show per entity; defaults to 3",
          "type": "integer"
        },
        "limit": {
          "description": "how many entities to include; defaults to 50",
          "type": "integer"
        }
      },
      "type": "object"
    },
    "name": "memory_digest",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "covered": {
          "description": "false when the memory is larger than the digest and search is still needed",
          "type": "boolean"
        },
        "entities": {
          "type": "integer"
        },
        "facts": {
          "type": "integer"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "entities",
        "facts",
        "covered"
      ],
      "type": "object"
    },
    "title": "Memory index"
  },
  {
    "annotations": {
