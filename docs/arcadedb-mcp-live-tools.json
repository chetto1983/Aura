  {
    "annotations": {
      "idempotentHint": false,
      "readOnlyHint": false
    },
    "description": "Store one fact as a bitemporal edge between two entities. A fact is never overwritten: when it is superseded its validity window is closed, so both what is true now and what was true then stay answerable.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "string",
          "description": "the entity the fact is about"
        },
        "predicate": {
          "type": "string",
          "description": "the relation, e.g. lives_in"
        },
        "object": {
          "type": "string",
          "description": "the entity or value the subject relates to"
        },
        "statement": {
          "type": "string",
          "description": "the fact in natural language; this is what gets embedded and searched"
        },
        "valid_from": {
          "type": "string",
          "description": "RFC3339 instant when the fact became true; defaults to now"
        },
        "valid_to": {
          "type": "string",
          "description": "RFC3339 instant when the fact stopped being true; omit while it still holds"
        },
        "supersedes": {
          "type": "boolean",
          "description": "close any still-valid fact with the same subject and predicate"
        },
        "source_run_id": {
          "type": "string",
          "description": "which run wrote this; required so everything a run produced can be found and removed"
        },
        "source_memory_ids": {
          "type": [
            "null",
            "array"
          ],
          "items": {
            "type": "string"
          },
          "description": "ids of the messages this was derived from"
        }
      },
      "required": [
        "subject",
        "predicate",
        "object",
        "statement",
        "source_run_id"
      ],
      "additionalProperties": false
    },
    "name": "memory_upsert_fact",
    "outputSchema": {
      "type": "object",
      "properties": {
        "statement": {
          "type": "string"
        },
        "superseded": {
          "type": "integer",
          "description": "how many previously-valid facts had their window closed"
        }
      },
      "required": [
        "statement",
        "superseded"
      ],
      "additionalProperties": false
    },
    "title": "Remember a fact"
  }
]