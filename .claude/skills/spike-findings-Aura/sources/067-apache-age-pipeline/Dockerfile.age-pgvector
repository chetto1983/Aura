# Spike 067 — Apache AGE + pgvector in one Postgres, to test whether AGE can host
# Aura's full graph pipeline (graphview reads + agent-memory subgraph + GraphRAG
# vectors) as a Neo4j replacement. AGE 1.7.0 ships on PG18 (Debian 13 trixie) with
# the pgdg apt repo already configured, so pgvector installs as a package — no
# source build. Throwaway image; not part of the production compose.
FROM apache/age:latest

USER root
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends postgresql-18-pgvector; \
    rm -rf /var/lib/apt/lists/*
USER postgres
