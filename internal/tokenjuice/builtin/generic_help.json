{
  "id": "generic/help",
  "family": "help",
  "description": "Preserve help text with generous head/tail (priority=25 wins over specific tool rules).",
  "priority": 25,
  "match": {
    "argvIncludesAny": [["--help"], ["help"]],
    "commandIncludesAny": [" --help", " help"]
  },
  "transforms": {
    "stripAnsi": true,
    "trimEmptyEdges": true,
    "dedupeAdjacent": true
  },
  "summarize": {
    "head": 80,
    "tail": 40
  },
  "failure": {
    "preserveOnFailure": true,
    "head": 40,
    "tail": 20
  }
}
