{
  "id": "install/npm-install",
  "family": "dependency-install",
  "description": "Compact npm install output: matchOutput short-circuit for no-op runs.",
  "onEmpty": "npm install: ok",
  "matchOutput": [
    {"pattern": "up to date, audited \\d+ package", "message": "npm install: up to date", "flags": "i"}
  ],
  "match": {
    "argv0": ["npm"],
    "argvIncludes": [["install"]]
  },
  "transforms": {
    "stripAnsi": true,
    "trimEmptyEdges": true,
    "dedupeAdjacent": true
  },
  "filters": {
    "skipPatterns": [
      {"pattern": "^npm notice "}
    ]
  },
  "summarize": {
    "head": 6,
    "tail": 4
  },
  "counters": [
    {"name": "vulnerability", "pattern": "vulnerabilit"},
    {"name": "warning", "pattern": "^npm warn", "flags": "i"}
  ],
  "failure": {
    "preserveOnFailure": true,
    "head": 8,
    "tail": 8
  }
}
