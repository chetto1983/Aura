{
  "id": "aura/web-fetch",
  "family": "aura-tool",
  "description": "Compact web{action=fetch} output via head/tail to reduce HTML/markdown size.",
  "match": {
    "toolNames": ["web"],
    "argvIncludes": [["fetch"]]
  },
  "transforms": {
    "stripAnsi": true,
    "trimEmptyEdges": true,
    "dedupeAdjacent": true
  },
  "summarize": {
    "head": 30,
    "tail": 10
  },
  "failure": {
    "preserveOnFailure": true,
    "head": 30,
    "tail": 20
  }
}
