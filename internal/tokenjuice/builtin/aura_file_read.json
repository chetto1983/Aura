{
  "id": "aura/file-read",
  "family": "aura-tool",
  "description": "Compact file{action=read} output: keep metadata (path/type/bytes), drop content. Fixes raw-JSON-echo bug (2026-05-18).",
  "match": {
    "toolNames": ["file"],
    "argvIncludes": [["read"]]
  },
  "transforms": {
    "prettyPrintJson": true,
    "trimEmptyEdges": true,
    "dedupeAdjacent": false
  },
  "filters": {
    "skipPatterns": [
      {"pattern": "\"content\":"}
    ]
  },
  "summarize": {
    "head": 20,
    "tail": 2
  }
}
