{
  "id": "tests/go-test",
  "family": "test-results",
  "description": "Compact go test output: skip passing packages, surface failures.",
  "onEmpty": "go test: ok",
  "match": {
    "argv0": ["go"],
    "argvIncludes": [["test"]]
  },
  "transforms": {
    "stripAnsi": true,
    "trimEmptyEdges": true,
    "dedupeAdjacent": true
  },
  "filters": {
    "skipPatterns": [
      {"pattern": "^ok\\s"}
    ]
  },
  "summarize": {
    "head": 6,
    "tail": 20
  },
  "counters": [
    {"name": "failed package", "pattern": "^FAIL\\s"}
  ],
  "failure": {
    "preserveOnFailure": true,
    "head": 8,
    "tail": 30
  }
}
