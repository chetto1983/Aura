{
  "id": "git/log-oneline",
  "family": "git-history",
  "description": "Compact git log --oneline output with commit counter.",
  "match": {
    "argv0": ["git"],
    "argvIncludes": [["log"], ["--oneline"]]
  },
  "transforms": {
    "stripAnsi": true,
    "trimEmptyEdges": true,
    "dedupeAdjacent": true
  },
  "summarize": {
    "head": 8,
    "tail": 6
  },
  "counters": [
    {"name": "commit", "pattern": "^[a-f0-9]{7,}\\s"}
  ],
  "failure": {
    "preserveOnFailure": true,
    "head": 10,
    "tail": 8
  }
}
