        "type": "string"
       },
       "mods": {
        "additionalProperties": false,
        "description": "Modifier keys (cmd = Command on macOS / Ctrl elsewhere; alt = Option)",
        "properties": {
         "alt": {
          "type": "boolean"
         },
         "cmd": {
          "type": "boolean"
         },
         "shift": {
          "type": "boolean"
         }
        },
        "type": "object"
       },
       "x": {
        "description": "x (pt)",
        "type": "number"
       },
       "y": {
        "description": "y (pt)",
        "type": "number"
       }
      },
      "required": [
       "kind",
       "x",
       "y"
      ],
      "type": "object"
     },
     "type": "array"
    },
    "mods": {
     "additionalProperties": false,
     "description": "Modifier keys (cmd = Command on macOS / Ctrl elsewhere; alt = Option)",
     "properties": {
      "alt": {
       "type": "boolean"
      },
      "cmd": {
       "type": "boolean"
      },
      "shift": {
       "type": "boolean"
      }
     },
     "type": "object"
