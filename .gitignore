# Go build artifacts
*.exe
*.dll
*.so
*.dylib
*.test
*.out
/aura
/arcadedb-mcp
/bin/
/dist/
# Only the installed dependencies, NEVER the frontend itself. A bare `web/` here
# ignores every source file: git keeps already-tracked files, so nothing visibly
# breaks, but knip respects .gitignore and silently sees an EMPTY project — it then
# reports all 32 dependencies unused and the web-deadcode pre-push gate fails with a
# report that contradicts itself (cytoscape "unused" while ArcadeGraphCanvas imports it).
web/node_modules/
# internal/webui/dist/ is the committed //go:embed source (D-05) — Go embed is
# package-relative (no ../web/dist), so the build output is co-located with
# embed.go. Keep it tracked even if a broader dist/ ignore is ever added
# (defensive negation, Pitfall 8).
!internal/webui/dist/

# IDE + editor
.idea/
.vscode/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Aura runtime (host-visible, must not be tracked)
/data/
/runtime-workspace/
/garage/
/aura.db
/aura.db-shm
/aura.db-wal
/.env
/.env.*
!/.env.example

# Worktrees + planning workspace (kept locally only)
/.worktrees
/.worktrees/
/.planning/tmp/

# Python venv created for tooling experiments
**/.venv/
**/__pycache__/
*.pyc

# Test coverage
coverage.txt
coverage.html
cover.out
cover_phase2.out
cover_gate.out*
*.out.filtered
.codex/*

# Quality-tooling byproducts (never commit)
#   pgregory/rapid persists failing seeds here; go-mutesting mutates source in
#   place leaving a <file>.go.tmp backup. Both flicker into the tree during a
#   mutation campaign — keep them untrackable.
**/testdata/rapid/
*.go.tmp
#   go test -coverprofile outputs, gremlins/go-mutesting run reports, and live
#   soak logs are local evidence, not source — keep them out of the tree.
/report.json
/phase071_agent_llm
docs/*-live-soak-*.log

# Claude Code: GSD installation is committed (vedi CLAUDE.md §GSD tooling).
# Local cache/sessions transient are excluded.
.claude/*
skills-lock.json
nul
output/*
internal/runner/conversations/*
web/node_modules.broken/*
.tmp/*
env.linux
web/.stryker-tmp-onb/*
graphify-out/*
# graphify knowledge graph: keep the human-readable report trackable, ignore the
# heavy rebuildable machine artifacts (~30MB graph.json + snapshot). Rebuild with
# the native graphify CLI: `pip install graphifyy` then `graphify update .`
# (~/bin/graphify.exe; the auto_update PostToolUse hook runs it after commits).
.planning/graphs/*
.agents/skills/*
internal/channels/telegram/testdata/*
artifacts/*
.playwright-mcp/*
.planning/phases/32-quality-cleanup-dead-code-shared-helpers/uat-evidence/phase32-focustrap-dialog.png
.tmp*
.audit-build-*
# transient conversation store written by cmd/aura tests
cmd/aura/conversations/
# same AURA_RUN_DIR-unset fallback, tripped by 52-04's real-tool-dispatch e2e test
internal/agui/conversations/
# subagent-driven-development scratch: ledger, task briefs, review packages
.superpowers/
docs/audit/live-conversations-*

# Local node toolchain pulled in for fixture generation (docx-js, pptxgenjs).
node_modules/

# Database dumps taken before a migration. They are recovery artefacts, not source,
# and a stray `git add -A` would otherwise commit a full copy of the deployment.
backups/

# LibreOffice lock files, created during fixture conversion.
.~lock.*#

# GSD run-scoped executor-isolation sentinel. Records the isolation mode resolved
# for the current dispatch so the guard hooks can read it; regenerated every run
# and meaningless across machines.
.gsd/
.planning/phases/51-durable-delegation/live-check/out/
tmp/*
.bg-shell/*
.mcp.json

# Built by packages/create-aura/scripts/build-artifact.mjs at prepack; never committed.
packages/create-aura/install-appliance.run
