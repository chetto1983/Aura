# Aura appliance compose unit.
#
# Install:
#   sudo install -d /opt/aura
#   sudo cp compose.yaml compose.minipc.yaml /opt/aura/
#   sudo cp -r caddy /opt/aura/
#   sudo cp deploy/aura.service /etc/systemd/system/aura.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now aura.service
#   journalctl -u aura.service -f
#
# Optional gVisor tier (native Linux only; never Docker Desktop):
#   sudo apt-get update && sudo apt-get install -y apt-transport-https ca-certificates curl gnupg
#   curl -fsSL https://gvisor.dev/archive.key \
#     | sudo gpg --dearmor -o /usr/share/keyrings/gvisor-archive-keyring.gpg
#   echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/gvisor-archive-keyring.gpg] https://storage.googleapis.com/gvisor/releases release main" \
#     | sudo tee /etc/apt/sources.list.d/gvisor.list >/dev/null
#   sudo apt-get update && sudo apt-get install -y runsc
#   sudo runsc install
#   sudo systemctl reload docker
# Then set AURA_RUNTIME=runsc in /opt/aura/.env — nessun drop-in e nessun -f: questa
# unit resta identica nei due casi.
# gVisor requires Linux 4.14.77+ and supports amd64/arm64; it is a transparent
# isolation boundary, not capability stripping.
#
# Su appliance senza GPU aggiungere anche, sempre in /opt/aura/.env:
#   COMPOSE_FILE=compose.yaml:compose.minipc.yaml
#   AURA_EMBED_NGL=0

[Unit]
Description=Aura appliance compose stack
Documentation=https://github.com/chetto1983/aura
After=network-online.target docker.service
Wants=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/aura
# Nessun -f: un -f esplicito VINCE su COMPOSE_FILE, quindi cablarlo qui farebbe ignorare
# in silenzio compose.minipc.yaml sulle appliance — che e' precisamente il guasto muto
# che questa impostazione esiste per rendere impossibile. Il set di file lo decide
# COMPOSE_FILE in /opt/aura/.env, letto da WorkingDirectory.
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
