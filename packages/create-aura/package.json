{
  "name": "create-aura-appliance",
  "version": "0.1.0",
  "description": "Interactive local and remote installer for the Aura appliance",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chetto1983/Aura.git",
    "directory": "packages/create-aura"
  },
  "type": "module",
  "bin": {
    "create-aura-appliance": "dist/bin.js"
  },
  "files": [
    "dist",
    "install-appliance.run",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/sync-preflight-floors.mjs --check && node scripts/clean-dist.mjs && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:artifact": "node scripts/build-artifact.mjs",
    "prepack": "npm run build && npm run build:artifact",
    "sync:floors": "node scripts/sync-preflight-floors.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.0",
    "execa": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
