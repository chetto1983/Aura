# Normalize line endings: store everything LF in the repo, check out LF on every
# platform. Kills the "LF will be replaced by CRLF" churn on Windows and keeps
# shell scripts runnable in the Linux containers / CI without CRLF breakage.
* text=auto eol=lf

# Scripts and Go must always be LF regardless of autocrlf.
*.sh    text eol=lf
*.go    text eol=lf
*.cypher text eol=lf
Makefile text eol=lf

# Frontend: pin LF for every web/ source and the committed embed dist bytes
# (internal/webui/dist, the //go:embed source) so the cross-host
# (WSL/Windows/CI) freshness gate stays byte-stable — a CRLF round-trip would
# forge a stale-dist diff. text-only globs; *.png stays binary via the rule below.
web/**                  text eol=lf
internal/webui/dist/**  text eol=lf

# Minified vendor chunks may contain semantically significant spaces before a
# newline inside template literals (for example Markdown's hard-break token).
# Keep every other whitespace check while excluding that generated byte pattern.
internal/webui/dist/assets/*.js whitespace=-trailing-space

# Generated code — exclude from language stats and collapse in diffs/reviews.
internal/db/sqlc/**     linguist-generated=true
go.sum                  linguist-generated=true

# Binary assets: never touch EOL, never diff as text. Listed AFTER the broad
# `web/** text eol=lf` / `internal/webui/dist/** text eol=lf` globs so these
# extension rules override them — a future font/wasm/modern-image the Vite/Workbox
# build emits must NOT be LF-normalized (corrupts bytes + forges a stale-dist diff).
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.dump  binary
*.gz    binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.webp  binary
*.avif  binary
*.wasm  binary
