{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aura.adaptive.benchmark-report/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "revision", "run_id", "mode", "portability_only", "started_at", "completed_at", "seed", "git", "environment", "model", "frozen_inputs", "scenarios", "controls", "summary", "verdict"],
  "properties": {
    "schema_id": {"const": "aura.adaptive.benchmark-report/v1"},
    "revision": {"const": 1},
    "run_id": {"$ref": "#/$defs/uuid"},
    "mode": {"enum": ["qwen-portability", "production-shadow"]},
    "portability_only": {"type": "boolean"},
    "started_at": {"$ref": "#/$defs/timestamp"},
    "completed_at": {"$ref": "#/$defs/timestamp"},
    "seed": {"const": 10620260726},
    "git": {"$ref": "#/$defs/git"},
    "environment": {"$ref": "#/$defs/environment"},
    "model": {"$ref": "#/$defs/model"},
    "frozen_inputs": {"$ref": "#/$defs/frozen_inputs"},
    "scenarios": {
      "type": "array",
      "minItems": 52,
      "maxItems": 52,
      "items": {"$ref": "#/$defs/scenario"}
    },
    "controls": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/control"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "verdict": {"$ref": "#/$defs/status"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "nullable_uuid": {
      "oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]
    },
    "nullable_string": {
      "oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
    },
    "nullable_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "status": {"enum": ["pass", "fail", "invalid"]},
    "domain": {
      "enum": ["reasoning", "tool_discovery", "skill_routing", "knowledge_retrieval", "memory_recall"]
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["answer_mismatch", "assignment_missing", "control_failed", "delivery_missing", "driver_failure", "evaluator_ineligible", "evaluator_mismatch", "fact_linkage_invalid", "memory_epoch_mismatch", "model_parser_failure", "model_transport_failure", "outcome_missing", "privacy_violation", "provenance_missing", "request_missing", "result_order_mismatch", "settings_apply_failure", "settings_restore_failure", "skill_mismatch", "stale_override_recovery", "timeout", "tool_mismatch"]
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty", "changed_files"],
      "properties": {
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "dirty": {"type": "boolean"},
        "changed_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "aura_version", "go_version", "migration_head", "neo4j_revision", "agent_memory_revision"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "arch": {"type": "string", "minLength": 1},
        "aura_version": {"type": "string", "minLength": 1},
        "go_version": {"type": "string", "minLength": 1},
        "migration_head": {"type": "string", "minLength": 1},
        "neo4j_revision": {"$ref": "#/$defs/nullable_string"},
        "agent_memory_revision": {"$ref": "#/$defs/nullable_string"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "model_id", "base_url_class", "server_name", "server_version", "server_revision", "artifact_name", "artifact_sha256", "snapshot_revision", "image_digest"],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "base_url_class": {"enum": ["loopback", "remote"]},
        "server_name": {"$ref": "#/$defs/nullable_string"},
        "server_version": {"$ref": "#/$defs/nullable_string"},
        "server_revision": {"$ref": "#/$defs/nullable_string"},
        "artifact_name": {"$ref": "#/$defs/nullable_string"},
        "artifact_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "snapshot_revision": {"$ref": "#/$defs/nullable_string"},
        "image_digest": {
          "oneOf": [{"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, {"type": "null"}]
        }
      }
    },
    "frozen_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "dataset_revision", "dataset_sha256", "prompt_template_sha256", "evaluator_id", "evaluator_revision", "calibration_sha256", "action_catalogs_sha256", "policy_version", "policy_sha256", "snapshot_id", "snapshot_sha256", "price_table_id", "price_table_revision", "price_table_sha256", "seed"],
      "properties": {
        "dataset_id": {"const": "aura/adaptive-aura-benchmark-dataset"},
        "dataset_revision": {"const": 1},
        "dataset_sha256": {"const": "ab65400e241a9a000f206f0aa360acc9d43272acee9cd69906e14439fce06df0"},
        "prompt_template_sha256": {"$ref": "#/$defs/sha256"},
        "evaluator_id": {"const": "aura/adaptive-deterministic-checker"},
        "evaluator_revision": {"const": 1},
        "calibration_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "action_catalogs_sha256": {"$ref": "#/$defs/sha256"},
        "policy_version": {"type": "string", "minLength": 1},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_id": {"$ref": "#/$defs/nullable_uuid"},
        "snapshot_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "price_table_id": {"$ref": "#/$defs/nullable_string"},
        "price_table_revision": {
          "oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]
        },
        "price_table_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "seed": {"const": 10620260726}
      }
    },
    "action_probability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "probability"],
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "probability": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator_id", "evaluator_revision", "value", "eligible", "reason_codes"],
      "properties": {
        "evaluator_id": {"type": "string", "minLength": 1},
        "evaluator_revision": {"type": "integer", "minimum": 1},
        "value": {"oneOf": [{"type": "number"}, {"type": "null"}]},
        "eligible": {"type": "boolean"},
        "reason_codes": {"$ref": "#/$defs/reason_codes"}
      }
    },
    "nullable_observation": {
      "oneOf": [{"$ref": "#/$defs/observation"}, {"type": "null"}]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "domain", "request_id", "assignment_id", "delivery_event_id", "quality_outcome_id", "harm_outcome_id", "champion_action_id", "recommended_action_id", "intended_action_id", "actual_action_id", "action_probabilities", "quality", "harm", "prompt_tokens", "completion_tokens", "total_tokens", "latency_ns", "cost_usd", "status", "reason_codes"],
      "properties": {
        "scenario_id": {"type": "string", "pattern": "^[rts][0-1][0-9]$|^[km]0[1-8]$"},
        "domain": {"$ref": "#/$defs/domain"},
        "request_id": {"$ref": "#/$defs/nullable_uuid"},
        "assignment_id": {"$ref": "#/$defs/nullable_uuid"},
        "delivery_event_id": {"$ref": "#/$defs/nullable_uuid"},
        "quality_outcome_id": {"$ref": "#/$defs/nullable_uuid"},
        "harm_outcome_id": {"$ref": "#/$defs/nullable_uuid"},
        "champion_action_id": {"type": "string"},
        "recommended_action_id": {"type": "string"},
        "intended_action_id": {"type": "string"},
        "actual_action_id": {"type": "string"},
        "action_probabilities": {
          "type": "array",
          "items": {"$ref": "#/$defs/action_probability"}
        },
        "quality": {"$ref": "#/$defs/nullable_observation"},
        "harm": {"$ref": "#/$defs/nullable_observation"},
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "latency_ns": {"type": "integer", "minimum": 0},
        "cost_usd": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
        "status": {"$ref": "#/$defs/status"},
        "reason_codes": {"$ref": "#/$defs/reason_codes"}
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "started_at", "completed_at", "evidence_ids", "reason_codes"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "started_at": {"$ref": "#/$defs/timestamp"},
        "completed_at": {"$ref": "#/$defs/timestamp"},
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/uuid"}
        },
        "reason_codes": {"$ref": "#/$defs/reason_codes"}
      }
    },
    "domain_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "scenario_count", "pass_count", "fail_count", "invalid_count"],
      "properties": {
        "domain": {"$ref": "#/$defs/domain"},
        "scenario_count": {"type": "integer", "minimum": 0},
        "pass_count": {"type": "integer", "minimum": 0},
        "fail_count": {"type": "integer", "minimum": 0},
        "invalid_count": {"type": "integer", "minimum": 0}
      }
    },
    "nullable_integer": {
      "oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_count", "pass_count", "fail_count", "invalid_count", "prompt_tokens", "completion_tokens", "total_tokens", "latency_count", "latency_p50_ns", "latency_p95_ns", "latency_p99_ns", "cost_count", "cost_usd", "domains"],
      "properties": {
        "scenario_count": {"type": "integer", "minimum": 0},
        "pass_count": {"type": "integer", "minimum": 0},
        "fail_count": {"type": "integer", "minimum": 0},
        "invalid_count": {"type": "integer", "minimum": 0},
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "latency_count": {"type": "integer", "minimum": 0},
        "latency_p50_ns": {"$ref": "#/$defs/nullable_integer"},
        "latency_p95_ns": {"$ref": "#/$defs/nullable_integer"},
        "latency_p99_ns": {"$ref": "#/$defs/nullable_integer"},
        "cost_count": {"type": "integer", "minimum": 0},
        "cost_usd": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
        "domains": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/domain_summary"}
        }
      }
    }
  }
}
