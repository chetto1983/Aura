{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aura.adaptive.benchmark-control-matrix/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision", "controls", "concurrency"],
  "properties": {
    "revision": {
      "const": 1
    },
    "controls": {
      "const": [
        "negative_control",
        "static_equivalence",
        "restart_recovery",
        "rollback_static",
        "privacy_redaction",
        "retention_cleanup",
        "same_owner_concurrency",
        "cross_owner_isolation",
        "assignment_write_failure",
        "delivery_write_failure",
        "outcome_write_failure",
        "model_transport_failure",
        "memory_epoch_mismatch",
        "settings_apply_failure",
        "settings_restore_failure",
        "stale_override_recovery"
      ]
    },
    "concurrency": {
      "const": {
        "clients": [
          {
            "client_id": "C0",
            "owner_alias": "A",
            "conversation_alias": "A0",
            "scenario_id": "r01"
          },
          {
            "client_id": "C1",
            "owner_alias": "A",
            "conversation_alias": "A0",
            "scenario_id": "r02"
          },
          {
            "client_id": "C2",
            "owner_alias": "A",
            "conversation_alias": "A1",
            "scenario_id": "m01"
          },
          {
            "client_id": "C3",
            "owner_alias": "B",
            "conversation_alias": "B0",
            "scenario_id": "k01"
          }
        ],
        "block_after": "assignment_commit_before_model_execution",
        "release_order": ["C3", "C2", "C0", "C1"],
        "assertions": [
          "unique_request_and_assignment_ids",
          "c1_assignment_after_c0_terminal",
          "c2_c3_assignment_before_c0_release",
          "no_cross_owner_facts",
          "one_delivery_per_exposed_assignment",
          "static_champion_probability_one"
        ]
      }
    }
  }
}
