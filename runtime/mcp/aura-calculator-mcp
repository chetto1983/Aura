#!/bin/sh
set -eu

repo="${AURA_CALCULATOR_MCP_REPO:-https://github.com/chetto1983/calculator-mcp-server.git}"
rev="${AURA_CALCULATOR_MCP_REV:-46a1e66709bc387e8c223f15ec25fb5ae3a1af08}"
base="${AURA_CALCULATOR_MCP_DIR:-/app/runtime/mcp}"
target="${base}/calculator-mcp-server-${rev}"

export UV_CACHE_DIR="${UV_CACHE_DIR:-/app/runtime/uv-cache}"

mkdir -p "$base" "$UV_CACHE_DIR"

if [ ! -d "$target/.git" ]; then
	tmp="${target}.tmp.$$"
	rm -rf "$tmp"
	git clone --quiet --filter=blob:none "$repo" "$tmp"
	git -C "$tmp" checkout --quiet --detach "$rev"
	rm -rf "$target"
	mv "$tmp" "$target"
fi

exec uv run --quiet --no-dev --project "$target" python "$target/calculator_server.py" "$@"
