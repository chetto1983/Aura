# Aura environment template. The installer creates .env and generates internal
# secrets automatically; end users should not hand-edit internal keys.
# .env is gitignored — never commit real secrets.
#
# Slice 0.5 ships Postgres only. Later slices append ArcadeDB, the embed sidecar
# (0.7), LLM (1), Telegram (9), etc. New keys land in the slice that owns them.

# ---- Stack ------------------------------------------------------------------
# Il runtime distribuito ha un solo file: compose.yaml.
# Gli overlay sotto .github/ appartengono esclusivamente alla CI.

# ---- Postgres ---------------------------------------------------------------
POSTGRES_IMAGE=postgres:18.4-alpine3.23
# Single password shared by the compose superuser AND the application roles
# (aura_app, aura_migrate). Local-dev convenience; production environments
# should set the AURA_DB_URL / AURA_DB_MIGRATE_URL overrides below with
# per-role credentials instead.
POSTGRES_PASSWORD=
POSTGRES_USER=aura
POSTGRES_DB=aura
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# Optional role-name overrides. Defaults match the 0001_init migration grants.
# AURA_DB_APP_ROLE=aura_app
# AURA_DB_MIGRATE_ROLE=aura_migrate

# Optional full-DSN overrides. When set, used verbatim; the POSTGRES_* primitives
# above are ignored for the corresponding role. Use these for managed Postgres
# (RDS, Cloud SQL) where the provider supplies the DSN per role.
# AURA_DB_URL=postgres://aura_app:...@host:5432/aura?sslmode=require
# AURA_DB_MIGRATE_URL=postgres://aura_migrate:...@host:5432/aura?sslmode=require

# Optional bootstrap URL for CREATE ROLE DDL. Defaults to the POSTGRES_USER
# (superuser) composed from POSTGRES_* above. Override when superuser DSN differs.
# AURA_DB_BOOTSTRAP_URL=postgres://aura:...@host:5432/aura?sslmode=require

# ---- Aura runtime -----------------------------------------------------------
# Runtime deployment profile ∈ {dev|local_trusted|single_user_hardened|
# server_production}. UNSET → dev. Selects config-validation strictness: the
# hardened/prod tiers turn knob-parse warnings into fatal errors and forbid
# insecure defaults (e.g. AURA_SHELL_DESTRUCTIVE_PATTERNS=off, sample creds).
#AURA_PROFILE=dev
# AURA_RUN_DIR=                                  # defaults to $UserCacheDir/aura
# In Compose, the aura-home volume is mounted here and stores config, skills,
# journals, and run artifacts.
AURA_CONFIG_DIR=/var/lib/aura
# Container resource knobs used by compose.yaml.
AURA_MEM_LIMIT=768m
AURA_CPUS=1.0
AURA_PIDS_LIMIT=512
# Loopback host publishes. Caddy is the LAN-facing entrypoint.
AURA_AGUI_PORT=9080
AURA_SETUP_PORT=9081
AURA_RUN_DIR=/var/lib/aura/runs
AURA_CONTEXT_PREVIEW_CAP_BYTES=30000
AURA_CONVERSATION_TURN_CAP_BYTES=65536
AURA_CONTEXT_TOOL_EVICT_AFTER_TURNS=10
# Retained compatibility name: rows per managed-history keyset page, not a recall cap.
AURA_HISTORY_HARD_CAP_TURNS=50
AURA_RUN_DIR_WARN_THRESHOLD_BYTES=1073741824
AURA_RUN_DIR_SWEEP_INTERVAL_SEC=3600
# Shell tool guardrails.
AURA_SHELL_BG_MAX=8
AURA_SHELL_BG_BUF_CAP=1048576
# Destructive-command approval gate. UNSET (this line commented out) OR an EMPTY
# value both keep the built-in default patterns active (gate stays ON), so copying
# this sample never disables it (D-12). Only an explicit "off" (case-insensitive)
# DISABLES the gate entirely — do that intentionally. Any other non-empty value
# REPLACES the defaults with your own comma-separated RE2 patterns.
#AURA_SHELL_DESTRUCTIVE_PATTERNS=
AURA_SHELL_MAX_TIMEOUT_MS=600000
AURA_SHELL_OUTPUT_BUF_CAP=1048576
# Filesystem tool guardrails.
AURA_FS_MAX_READ_BYTES=10485760
AURA_FS_WALK_NODE_CAP=50000
AURA_FS_WALK_TIMEOUT_MS=5000

# ---- Phase 17: appliance front door and optional sidecars -------------------
# Generated by install.sh for the appliance path. Required by caddy/Caddyfile.
AURA_IMAGE=aura:local
AURA_ACCESS_TOKEN=
AURA_HTTPS_PORT=443

# MCP Apps (SEP-1865): the SECOND origin the cockpit frames a mounted server's
# view from. A view is HTML that server wrote and it needs `allow-same-origin` to
# run, so it must never get the cockpit's origin. Set this to the caddy keyhole
# port below, on the SAME host you reach the cockpit by — e.g. https://aura.lan:8444
# or https://192.168.1.10:8444. Leave it empty to render no views at all (tools
# still return their text; nothing else changes).
# The browser must actually be able to LOAD this origin. On the appliance path it
# is fronted by Caddy's internal CA, and a certificate exception is per host:port
# and cannot be granted inside an iframe — so a browser that only clicked through
# for the cockpit will show a dead frame here. Install Caddy's root
# (/data/caddy/pki/authorities/local/root.crt) on the client, or use a hostname
# with a certificate the client already trusts. Empty = render no views at all.
AURA_MCP_SANDBOX_ORIGIN=
AURA_MCP_SANDBOX_PORT=8444
# Loopback by default: Caddy's :443 is the one port this appliance publishes.
# Widen only for a browser that is not on this host, and prefer a second hostname
# on :443 over a second port.
AURA_MCP_SANDBOX_BIND=127.0.0.1

# ---- Real hostnames with a publicly trusted certificate (ACME DNS-01) --------
# The IP/localhost path above serves an INTERNAL CA. A browser can be taught to
# accept that for the cockpit by clicking through once, but an MCP Apps view is an
# IFRAME, and a frame gets no interstitial to click — it just dies. So any
# deployment that actually renders views wants real certificates.
#
# DNS-01 issues a WILDCARD (HTTP-01 cannot) and needs nothing inbound at issuance
# time, so both origins come from one certificate and the appliance still
# publishes one port. deSEC (https://desec.io) gives a free <name>.dedyn.io with a
# REST API and DNSSEC; DuckDNS is NOT a substitute — it has no wildcard.
#
# Setup: register at desec.io, create a token, point A/AAAA at this host, then:
AURA_CADDYFILE=Caddyfile.domain
AURA_PUBLIC_HOST=aura.<name>.dedyn.io
AURA_VIEWS_HOST=views.<name>.dedyn.io
DESEC_TOKEN=
# ...and set AURA_MCP_SANDBOX_ORIGIN above to https://views.<name>.dedyn.io
# (AURA_MCP_SANDBOX_PORT / _BIND become unused: the views origin is a hostname
# on :443, not a second port).
# Memory MCP sibling; Aura uses Compose DNS in-container and this port on host.
# Memory is Aura's own remote ArcadeDB MCP (cmd/arcadedb-mcp). It follows the
# same discovery + OAuth flow as any other remote MCP; no token is configured here.
AURA_ARCADEDB_MCP_PORT=8096
# Optional WhatsApp MCP sibling; Aura's catalog default matches this loopback port.
AURA_WHATSAPP_MCP_PORT=8092
AURA_WHATSAPP_BRIDGE_PORT=8094
# Optional PIM/calendar MCP sibling.
AURA_PIM_MCP_PORT=8093

# ---- Slice 1: LLM client (OpenRouter, OpenAI-compat) ------------------------
# API key — CANONICAL third-party name (NOT renamed to AURA_*). Required:
# an empty key fails fast with a clear error (no silent fallback).
OPENROUTER_API_KEY=
# Management key — a DIFFERENT credential from the inference key above, created at
# https://openrouter.ai/settings/management-keys. It cannot call /chat/completions, and
# the inference key cannot read analytics: /activity, /analytics/meta and
# /analytics/query answer 403 "Only management keys" without it. OPTIONAL — leave empty
# and cost reporting falls back to /credits + /key, which need no extra credential.
OPENROUTER_MANAGEMENT_KEY=
# Built-in defaults shown; change these values to override. ~/.aura/llm.json also overrides.
AURA_LLM_BASE_URL=https://openrouter.ai/api/v1
AURA_LLM_MODEL=deepseek/deepseek-v4-flash-0731:nitro
AURA_LLM_TEMPERATURE=0.7
# The rest of the serving model's card. UNSET on purpose and left commented: an unset knob
# is omitted from the wire entirely, so a deployment that configures none of these sends
# exactly the request it sent before they existed. A configured 0.0 is a real instruction
# and is NOT the same as leaving one out (Qwen-family cards ask for min_p=0.0 explicitly).
# Set them to whatever the card of the model named above states — never copied from
# another model's card.
#AURA_LLM_TOP_P=0.95
#AURA_LLM_TOP_K=64
#AURA_LLM_MIN_P=0.0
#AURA_LLM_PRESENCE_PENALTY=0.0
#AURA_LLM_REPETITION_PENALTY=1.0
AURA_LLM_MAX_TOKENS=4096
AURA_LLM_STREAM_IDLE_TIMEOUT_SEC=60
AURA_MODEL_CONTEXT_WINDOW=1000000
AURA_MODEL_MAX_OUTPUT_TOKENS=32768
# Adaptive prompt policy for OpenRouter reasoning models:
# greeting/factual -> reasoning none, search/news -> low, code/proof/debug -> high.
AURA_LLM_ADAPTIVE_REASONING=true
# Master switch for surfacing live model reasoning in opted-in local surfaces
# (CLI and Telegram status pane). Default true matches the compiled config; set false to redact.
AURA_SHOW_REASONING=true
AURA_COMPLETION_GATE=true
AURA_COMPLETION_CRITIC_MODEL=
# Global timeout rides the request ctx (NOT http.Client.Timeout) so a healthy
# long stream is never aborted; connect timeout is on the dialer.
AURA_LLM_TOTAL_TIMEOUT_SEC=120
AURA_LLM_CONNECT_TIMEOUT_SEC=10

# ---- Optional LOCAL answering LLM (task-7, document-pipeline rewrite) -------
# Runs Aura fully offline on llama.cpp instead of OpenRouter — the only way to run the
# #115 production gate without spending OpenRouter credit. Opt-in via profile:
#   COMPOSE_PROFILES=localllm docker compose up -d
# then point the daemon at it for a gate run by setting the vars near the top of this
# file to:
#   AURA_LLM_BASE_URL=http://aura-llm:8084/v1
#   AURA_LLM_MODEL=gemma-4-12b
#   AURA_LLM_PROVIDER=llamacpp
#   AURA_LLM_TEMPERATURE=1.0
#   AURA_LLM_TOP_P=0.95
#   AURA_LLM_TOP_K=64
# This repo's own .env (not this template) still points AURA_LLM_BASE_URL at
# https://openrouter.ai/api/v1 — that live file is the operator's and is never edited
# silently; every gate run flips these by hand (or by environment override).
#
# The three sampling lines are gemma-4-12B-it's OWN card, and they belong in the CLIENT
# env rather than only in compose, because llama.cpp honours a client-supplied value over
# its server flag. AURA_LLM_TEMPERATURE especially: it is always sent, so leaving it at
# 0.7 serves this model at 0.7 no matter what compose says. The other four
# (AURA_LLM_TOP_P / TOP_K / MIN_P / PRESENCE_PENALTY / REPETITION_PENALTY) are UNSET by
# default and omitted from the wire entirely, so those fall through to the server flags
# unless set here. min_p is left unset on purpose: the gemma-4 card is silent on it.
#
# The model thinks BEFORE it answers and reasoning tokens count against the SAME
# max_tokens budget as the answer. MEASURED 2026-08-22 over six prompts: at
# max_tokens=4096, THREE came back with `content` empty and everything in
# `reasoning_content` — no error, no truncation flag. At this deployment's real
# AURA_LLM_MAX_TOKENS=32768 it was zero of six. Size AURA_LLM_MAX_TOKENS above generously,
# and treat empty content + non-empty reasoning_content as its own failure class.
#
# aura-llm serves PRE-FETCHED local GGUFs, not --hf-repo (same reasoning as the embed
# sidecar's AURA_EMBED_MODEL_PATH below: a first boot that has to reach HuggingFace fails
# and restart-loops). scripts/fetch_llm_model.sh pins BOTH files of
# unsloth/gemma-4-12B-it-qat-GGUF by exact byte size AND SHA-256 at one commit, and
# refuses anything else — place both verified files at these paths before the first `up`:
#   bash scripts/fetch_llm_model.sh --artifact model <dir>/gemma-4-12B-it-qat-UD-Q4_K_XL.gguf
#   bash scripts/fetch_llm_model.sh --artifact draft <dir>/mtp-gemma-4-12B-it.gguf
# (`--show` prints the pinned url/size/sha256 for either without downloading anything.)
AURA_LLM_MODEL_PATH=/root/.cache/llama.cpp/gemma-4-12B-it-qat-UD-Q4_K_XL.gguf
AURA_LLM_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
AURA_LLM_ALIAS=gemma-4-12b
AURA_LLM_PORT=8084
AURA_LLM_NGL=99
# MTP speculative decoding — the drafter is half the reason this model is usable here.
# MEASURED 2026-08-22, six prompts through /v1/chat/completions at production budgets:
# 60.4 tok/s median with the drafter against 34.9 without. n-max=4 accepts 61% of what it
# drafts; n-max=2 accepts 74% and finishes the same six in the same wall-clock; n-max=8
# regresses to 38.5% and 50.6 tok/s. Past ~4 the drafter is guessing.
AURA_LLM_DRAFT_MODEL_PATH=/root/.cache/llama.cpp/mtp-gemma-4-12B-it.gguf
AURA_LLM_SPEC_DRAFT_N_MAX=4
AURA_LLM_SPEC_DRAFT_NGL=99
# gemma-4-12B-it declares a 262144-token native context — this default is NOT that
# ceiling, it is what a 12GB card holds. MEASURED 2026-08-22: the whole GPU sat at
# 9,260 MiB of 12,288 at -c 81920 with q8_0 KV, the drafter loaded and aura-llama-embed
# resident. Re-measure before raising it on other hardware.
AURA_LLM_CTX=32768
AURA_LLM_PARALLEL=1
AURA_LLM_KV_QUANT=q8_0
# on|off|auto — auto follows the model's own chat-template default (thinks).
AURA_LLM_REASONING=auto
# -1 unrestricted, 0 off, N to bound thinking-token latency.
AURA_LLM_REASONING_BUDGET=-1
# Server-side floor for anything that talks to port 8084 WITHOUT naming a value. These
# are the gemma-4-12B-it card's own numbers (its own defaults are 0.80 / 0.95 / 40), and
# top_p is stated even though it equals llama.cpp's default so the served configuration is
# readable here rather than inherited from an engine default that can change.
AURA_LLM_SERVER_TEMP=1.0
AURA_LLM_SERVER_TOP_P=0.95
AURA_LLM_SERVER_TOP_K=64

# ---- Slice 1: OpenTelemetry tracing -----------------------------------------
# Exporter ∈ {stdout, otlp, none}. Default otlp → silent-drops without a
# collector on the endpoint; "none" is a true no-op (zero tracing overhead).
AURA_OTEL_EXPORTER=otlp
AURA_OTEL_ENDPOINT=tempo:4317

# The appliance observability profile is on by default. Prometheus and Tempo are
# ordinary services on the project network; their private ports are not published,
# and only Grafana is reachable on host loopback. Set COMPOSE_PROFILES to another
# explicit list and AURA_OBSERVABILITY_CHECK_ENABLED=false to opt out together.
COMPOSE_PROFILES=observability
AURA_OBSERVABILITY_CHECK_ENABLED=true
#
# OTLP carries traces to Tempo. Metrics use only the private AURA_METRICS_BIND
# Prometheus scrape endpoint; Aura does not push a duplicate OTLP metric stream.
AURA_GRAFANA_PORT=3000
AURA_PROMETHEUS_RETENTION=15d
AURA_PROMETHEUS_RETENTION_SIZE=2GB
AURA_PROMETHEUS_MEM_LIMIT=384m
AURA_TEMPO_MEM_LIMIT=512m
AURA_GRAFANA_MEM_LIMIT=384m

# ---- ArcadeDB: long-term memory ---------------------------------------------
# Aura's memory lives here, ONE DATABASE PER IDENTITY. compose fail-fasts on the
# three secrets below, and compose interpolates the WHOLE file before it picks a
# service — so a missing one aborts every `docker compose` invocation, including
# ones that touch none of these containers.
ARCADEDB_PASSWORD=
# The scoped credential the memory sidecar reads and writes with. It is NOT root:
# ArcadeDB refuses server commands to anyone else, which is what keeps a tenant
# credential from creating or reaching another tenant's database.
ARCADEDB_APP_USER=aura_memory
ARCADEDB_APP_PASSWORD=
ARCADEDB_DATABASE=aura_memory
# At least 32 characters. Per-identity credentials are DERIVED from it
# (HMAC-SHA256 over the database name), so nothing per-tenant is ever stored —
# and rotating it invalidates every one of them at once. Plan it; do not restart
# into it.
AURA_ARCADEDB_TENANT_SECRET=

# ---- Slice 0.7: embed sidecar -----------------------------------------------
# Embeddings are the one leg you cannot afford to get wrong by omission: the
# adaptive-reasoning classifier embeds 27 anchors before EVERY turn, one call at a time,
# so a cloud embedder measured 1.4-2.1s per call turned a "ciao" into a 76s turn while
# the same request to the local sidecar is a few hundred ms.
#   in-compose local sidecar : http://aura-llama-embed:8081
#   host / CLI               : http://127.0.0.1:8081
#   cloud (GPU-less box)     : an OpenAI-compatible EmbeddingGemma endpoint
AURA_EMBED_BASE_URL=http://127.0.0.1:8081
# Image and NGL are ONE choice, not two: they must agree or the sidecar either fails to
# start or silently runs on CPU while you believe it is on the GPU.
#   GPU box : ghcr.io/ggml-org/llama.cpp:server-cuda + AURA_EMBED_NGL=99
#   CPU box : ghcr.io/ggml-org/llama.cpp:server      + AURA_EMBED_NGL=0
# CPU-only environments use the CPU pair only when their deployment removes the
# base stack's structural NVIDIA reservation.
AURA_EMBED_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
# The model is defaulted in compose (${VAR:-default}), so leaving this empty is safe and
# inherits EmbeddingGemma-300M. Pinning a value is what let a template and compose
# silently select different models — same width, different model, vectors from one
# environment meaningless in the other. Re-embed the corpus when you change the MODEL;
# changing only the width does not require it.
# There is deliberately NO pooling variable to set alongside it: the GGUF declares its
# own pooling and llama.cpp uses it, so the only thing a knob could add was a way to
# disagree with the file — which is precisely what happened once, at a cost of a third
# of recall@1, without a single error.
# The sidecar loads a LOCAL gguf: it has no egress, and a first boot that had to
# reach HuggingFace restart-looped and took memory down with it. Pre-fetch into the
# aura-llama-embed volume before the first `up`.
AURA_EMBED_MODEL_PATH=/root/.cache/llama.cpp/embeddinggemma-300M-Q8_0.gguf

AURA_EMBED_NGL=99
# Amendment #18 — boot self-test asserts this (Pitfall #5). It must equal the width
# the sidecar actually returns: a narrower response is an error, never a silent
# truncation. EmbeddingGemma-300M is 768 native, which is the compiled default too
# (config.DefaultEmbedDimensions) — change both together or not at all.
AURA_EMBED_DIMENSIONS=768

# ---- memory sidecar embedder (sidecar-owned, compose/.env only) --------------
# Point arcadedb-mcp's dense-retrieval embedder at a cloud OpenAI-compatible endpoint
# instead of the local sidecar. compose.yaml maps this to the container's
# AURA_EMBED_BASE_URL at START. It is NOT runtime-overridable via the cockpit Settings
# page (the daemon's os.Setenv overlay cannot reach an already-running sidecar).
#
# It must AGREE with AURA_EMBED_BASE_URL above: both write into the same ArcadeDB
# vector index, so embedding queries with one model and stored memories with another
# retrieves noise while every healthcheck stays green.
#   local: http://aura-llama-embed:8081
#   cloud: https://openrouter.ai/api/v1
#AURA_MEMORY_EMBED_BASE_URL=https://openrouter.ai/api/v1

# ---- ArcadeDB memory service hard bounds ------------------------------------
# Non-positive or malformed overrides fail arcadedb-mcp boot.
AURA_MEMORY_QUERY_MAX_RUNES=2048
AURA_MEMORY_ENTITY_MAX_RUNES=512
AURA_MEMORY_STATEMENT_MAX_RUNES=4096
AURA_MEMORY_DIGEST_SCAN_MAX_COUNT=2000
AURA_MEMORY_HYBRID_CANDIDATE_MAX_COUNT=400
# Calibrated for EmbeddingGemma-300M Q8_0. Re-measure both thresholds when the
# embedding model changes; they prevent a weak name overlap from becoming a fact.
AURA_MEMORY_DENSE_MAX_DISTANCE_RATIO=0.55
AURA_MEMORY_LEXICAL_MIN_SCORE=2
AURA_ARCADEDB_MCP_BODY_MAX_BYTES=1048576

# ---- Slice 0.9: agent loop Budget tree ---------------------------------------
# The hard 3-cap contract bounding a single agent Run (CLI flag > env > default).
# Hard cap on tool-call iterations within one Run.
AURA_LOOP_MAX_STEPS=25
# Hard wall-clock cap (seconds) before the Run returns a budget-exhausted Event.
AURA_LOOP_MAX_WALLCLOCK_SEC=300
# Consecutive-repeat dedup window: N identical tool_name+args_hash calls terminate.
AURA_LOOP_DEDUP_WINDOW=3

# Hardening knobs (A7). Defaults preserve the three-cap behavior above.
# CSV allowlist of tool names exempt from the dedup check (e.g. legitimate polls).
AURA_LOOP_DEDUP_EXEMPT_TOOLS=
# Passive per-branch fair-share fraction in (0,1]; non-terminal scheduling signal.
AURA_LOOP_BRANCH_SOFT_FRACTION=1.0
# Optional per-node soft timeout (seconds); 0 disables (only the run-wide cap applies).
AURA_LOOP_NODE_TIMEOUT_SEC=0
# Byte cap on the dedup result-preview progress veto.
AURA_LOOP_DEDUP_RESULT_CAP=2048
# Maximum concurrent tool executions inside one model-emitted batch.
AURA_LOOP_MAX_PARALLEL_TOOLS=4

# ---- Slice 9: swarm / scheduled agent caps ----------------------------------
AURA_SWARM_MAX_GOALS=8
AURA_SWARM_CHILD_TIMEOUT_SEC=120
AURA_SWARM_MAX_CONCURRENT=4
AURA_SWARM_MAX_DEPTH=2
AURA_AGENT_JOB_MAX_DURATION_SEC=600

# ---- Phase 51: durable background delegation --------------------------------
# Durable delegation row lease (seconds). MUST stay >= the measured effective
# worst-case worker lifetime (SwarmChildTimeoutSec + AURA_LLM_TOTAL_TIMEOUT_SEC
# = 240s, D-03/spike 099) or a live worker's lease can be reclaimed mid-run.
AURA_SWARM_DELEGATION_LEASE_SEC=300
# Claim-loop poll interval (seconds).
AURA_SWARM_DELEGATION_POLL_SEC=2
# Plan 51-02 (D-06/D-07): the two-TTL knobs the Postgres-backed steer queue derives
# each row's expires_at from, per its own kind. An operator steer is already harmful if
# delivered hours late; a worker's delegation report stays valid for hours. <=0
# explicitly disables expiry for that kind.
AURA_STEER_QUEUE_TTL_SEC=900
AURA_DELEGATION_RESULT_TTL_SEC=86400

# ---- Slice 5 (Phase 7): web_search / web_fetch ------------------------------
# Local SearXNG base URL. Empty = web_search disabled, surfaced as a structured
# web_search_unavailable{searxng_not_configured} at call time, NOT a boot error.
# Compose passes http://searxng:8080/search inside the Aura container; this
# host-loopback value is for local CLI/test runs outside Compose.
SEARXNG_URL=http://127.0.0.1:18080/search
AURA_SEARXNG_PORT=18080
# Per-conversation DNS pin TTL (seconds) — anti-rebinding SSRF defense (D-25).
AURA_WEB_DNS_PIN_TTL_SEC=60
# Raw HTTP response body download ceiling (bytes); DoS guard applied before readability
# extraction. The LLM-facing markdown preview/spillover is governed by the agent tool-result
# preview cap (AURA_CONTEXT_PREVIEW_CAP_BYTES), NOT this field (D-21).
AURA_WEB_FETCH_MAX_BODY_BYTES=5000000
# Opt-in disk cache; false = in-memory only (D-32).
AURA_WEB_CACHE_PERSISTENT=false
# web_search wall-clock deadline (seconds), one retry within it (D-14).
AURA_WEB_SEARCH_TIMEOUT_SEC=20
# web_fetch wall-clock deadline (seconds), one retry within it (D-23).
AURA_WEB_FETCH_TIMEOUT_SEC=10
# Aura-specific User-Agent — do NOT spoof a browser (D-34/D-35).
# Leave empty to use the compiled default (a browser UA). Setting a self-declaring
# bot UA here makes web_fetch time out on sites that refuse bots at the connection
# layer — see defaultWebUserAgent in internal/config/config.go.
AURA_WEB_USER_AGENT=
# Generated by install.sh for the internal SearXNG sidecar.
SEARXNG_SECRET=

# ---- Industrial asset object storage ----------------------------------------
AURA_OBJECTSTORE_BACKEND=garage
AURA_OBJECTSTORE_ENDPOINT=
AURA_OBJECTSTORE_PUBLIC_ENDPOINT=http://127.0.0.1:3900
AURA_OBJECTSTORE_REGION=garage
AURA_OBJECTSTORE_BUCKET=aura-assets
AURA_OBJECTSTORE_ACCESS_KEY=
AURA_OBJECTSTORE_SECRET_KEY=
AURA_OBJECTSTORE_PATH_STYLE=true
GARAGE_RPC_SECRET=
# Garage object replication factor. Default 1 (single-node dev/local). The
# server_production profile requires ≥2 for durability (PROF-06).
#AURA_OBJECTSTORE_REPLICATION_FACTOR=1
AURA_GARAGE_KEY_NAME=aura-assets-local
AURA_GARAGE_ZONE=dc1
AURA_GARAGE_CAPACITY=1G
AURA_ASSET_MAX_DOCUMENT_BYTES=104857600
AURA_ASSET_MAX_IMAGE_BYTES=26214400
AURA_ASSET_MAX_AUDIO_BYTES=104857600
AURA_ASSET_PRESIGN_TTL_SEC=600
AURA_ASSET_PROCESSING_CONCURRENCY=2

# ---- Document retrieval ----------------------------------------------------
AURA_DOCUMENT_MAX_PASSAGES_PER_VERSION=10000
AURA_DOCUMENT_MAX_ACTIVE_PASSAGES=100000
AURA_DOCUMENT_EMBED_BATCH_SIZE=32
AURA_DOCUMENT_PIPELINE_MAX_ATTEMPTS=5
AURA_DOCUMENT_PIPELINE_LEASE_SEC=1200
AURA_DOCUMENT_RETRIEVAL_CANDIDATES=200
AURA_DOCUMENT_DENSE_MAX_DISTANCE_RATIO=0.55
AURA_DOCUMENT_LEXICAL_MIN_SCORE=2
# Required in hardened/production: immutable deployed model revision and the SHA-256
# of the exact artifact served by the shared Aura embedding route.
AURA_EMBED_REVISION=
AURA_EMBED_FINGERPRINT=

# ---- Document-pipeline rewrite (amendment #118): CocoIndex ingest sidecar --
# The default-stack supervisor reads active identities and their encrypted Garage bindings
# from the existing database; do not copy tenant IDs/buckets/keys into this file.
AURA_INGEST_LIVE=true
AURA_INGEST_INTERVAL_SEC=60
AURA_INGEST_S3_PREFIX=
AURA_INGEST_SUPERVISOR_INTERVAL=15s

TELEGRAM_API_BASE_URL=
TELEGRAM_FILE_BASE_URL=
AURA_TELEGRAM_LOCAL_BOT_API=false

# ---- Slice 9: Telegram channel ----------------------------------------------
# Telegram keeps its upstream token name by convention. Empty = channel unconfigured
# until the setup wizard stores a token or the operator exports one.
TELEGRAM_BOT_TOKEN=
# Optional live Bot API integration target chat id. Required only for
# telegram_integration / scripts/telegram_e2e.sh.
AURA_E2E_CHAT_ID=
# Status/content throttles and per-chat send queue rate. Defaults mirror code.
AURA_TELEGRAM_STATUS_THROTTLE_MS=1500
AURA_TELEGRAM_CONTENT_THROTTLE_MS=500
AURA_TELEGRAM_CHAT_RATE_LIMIT_MS=1000
# Rolling live-CoT status-pane window cap. Ignored unless AURA_SHOW_REASONING=true.
AURA_REASONING_FIFO_RUNES=4096

# ---- Slice 9c: multimodal sidecar clients -----------------------------------
# Compose injects Docker-network base URLs for Aura. Host-loopback values are for
# live integration tests or running `aura serve` directly on the host.
AURA_VISION_CLOUD=false
MULTIMODAL_BASE_URL=http://127.0.0.1:8082/v1
MULTIMODAL_MODEL=glm-ocr
MULTIMODAL_TIMEOUT_SEC=120
STT_BASE_URL=http://127.0.0.1:9000/v1
STT_MODEL=large-v3-turbo
STT_LANGUAGE=it
STT_COMPUTE_TYPE=int8
STT_DEVICE=cpu
AURA_STT_PORT=9000
TTS_BASE_URL=http://127.0.0.1:8880/v1
TTS_VOICE=if_sara
TTS_FORMAT=opus
AURA_TTS_PORT=8880
AURA_OCR_VL_PORT=8082

# ---- Local embedding sidecar (GPU required) --------------------------------
# Aura's local memory/search path uses llama.cpp with NVIDIA offload by default.
# Docker must expose GPUs to containers (`docker run --gpus all ... nvidia-smi`
# should succeed). CPU mode is not the product default.

# ---- Generic stdio MCP servers ---------------------------------------------
# CLI-first path:
#   aura mcp install calculator
#   aura mcp doctor calculator
#   aura mcp tools calculator
# Managed servers live in Postgres (aura.mcp_server, migration 0101), beside the MCP audit
# ledger and the per-identity OAuth grants. There is no file and no env override: a second
# way to declare the same thing is a second thing to keep in sync, and the file version
# ended up with two readers that could disagree about which servers existed.
#
# Live MCP integration test gates (calculator_integration / calendar_integration /
# whatsapp_integration build tags). Each is a single mcp.ServerConfig object
# ({"command","args","env"}), NOT the mcpServers envelope. Unset → test skips.
# NOTE: shell-sourcing .env (`set -a; . ./.env`) strips the quotes inside unquoted
# JSON values — export these manually (escaped) when driving tests from bash.
# AURA_MCP_CALCULATOR_SERVER_JSON={"command":"uvx","args":["--from","calculator-mcp-server@git+https://github.com/chetto1983/calculator-mcp-server.git","--","calculator-mcp-server","--stdio"]}
# AURA_MCP_CALENDAR_SERVER_JSON=
# AURA_MCP_WHATSAPP_SERVER_JSON=

# ---- Slice 11: skills --------------------------------------------------------
AURA_SKILLS_DIR=/var/lib/aura/skills
AURA_SKILL_EXPORT_DIR=/var/lib/aura/exported-skills
AURA_SKILL_BODY_CAP_BYTES=32768
AURA_SKILL_MANIFEST_CAP_BYTES=8192
AURA_SKILL_SNIPPET_TTL_DAYS=90
AURA_SKILL_INJECTION_BLOCKLIST=

# ---- Slice 12: AG-UI / serve -------------------------------------------------
AURA_AGUI_BUFFER_CAP=64
AURA_AGUI_BIND=127.0.0.1:9080
# Unanswered approvals expire as an explicit refusal after 48 hours. <=0 disables.
AURA_ASKUSER_PAUSE_TTL_SEC=172800
AURA_SETUP_BIND=127.0.0.1:9081
AURA_SETUP_TOKEN=
# ---- Web auth boundary (Authula-only) ----------------------------------------
# AURA_AGUI_BIND is the cockpit HTTP bind (default 127.0.0.1:9080). WEB-02/D-06
# lifted the hardcoded-loopback restriction: it may now be a non-loopback address,
# but only when Authula is configured below or a reverse proxy is trusted.
# AURA_WEB_TRUST_PROXY: set true ONLY when a reverse proxy terminates auth in front
# of Aura; unlocks a non-loopback bind without Aura session enforcement. Default false.
AURA_WEB_TRUST_PROXY=false
AURA_SERVE_SHUTDOWN_GRACE_SEC=25
# ---- Authula web-auth provider (docs/cockpit-overhaul/05-authula-auth-SPEC.md) -
# Authula is the only active cockpit auth provider. The legacy passphrase provider is
# not mounted by `aura serve`.
AURA_WEB_AUTH_PROVIDER=authula
# AURA_AUTHULA_DATABASE_URL: Postgres DSN for the ISOLATED `authula` schema. Empty =
# derived from AURA_DB_URL with ?search_path=authula (H1 schema isolation). Set
# explicitly only to point Authula at a separate DB/role.
AURA_AUTHULA_DATABASE_URL=
# AURA_AUTHULA_SECRET: 32-byte hex secret Authula derives its HMAC/token keys from.
# Generated by install.sh for cockpit auth.
AURA_AUTHULA_SECRET=
# AURA_AUTHULA_RATE_LIMIT_MAX: credential attempts per one-minute Authula window.
# Keep the default in production; CI can raise it for parallel Playwright sign-ins.
AURA_AUTHULA_RATE_LIMIT_MAX=30
# AURA_AUTHULA_OPERATOR_IDENTITY: optional legacy Aura identity fallback for Authula.
# Leave empty for normal Authula/bootstrap installs; users link to real Aura identities.
AURA_AUTHULA_OPERATOR_IDENTITY=
# Optional Authula live/E2E cutover smoke credentials. These are not used by the
# daemon itself; the Playwright helper reads them when `/api/auth/config` reports
# `provider:"authula"`. Prefer the AURA_E2E_* names for disposable test operators;
# the AURA_AUTHULA_OPERATOR_* names are accepted as local convenience fallbacks.
AURA_AUTHULA_OPERATOR_EMAIL=
AURA_AUTHULA_OPERATOR_PASSWORD=
AURA_AUTHULA_OPERATOR_TOTP_SECRET=
AURA_E2E_AUTHULA_EMAIL=
AURA_E2E_AUTHULA_PASSWORD=
AURA_E2E_AUTHULA_TOTP_SECRET=
# Optional one-shot override when you cannot share the TOTP seed with the test runner.
AURA_E2E_AUTHULA_TOTP_CODE=

# ---- Slice 14: profiles ------------------------------------------------------
AURA_PROFILE_DIR=/var/lib/aura/agents
AURA_PROFILE_CERTAINTY_N=3

# ---- Slice 6 (Phase 10): scheduler + backups ---------------------------------
# Grammar triad at|every|cron (amendment #46). Default IANA tz for cron tasks
# lacking an explicit per-task tz; DB stays UTC, only next_run_at compute is
# tz-aware (DST-safe).
AURA_SCHEDULER_TZ=Europe/Rome
# Global fallback notify route ∈ {whatsapp, email, stdout, telegram}; a per-task
# `notify` payload field overrides it. Recipient is the default JID/email for the
# route. telegram is delivered by the scheduler's origin gate through the channel
# registry, not by an MCP self-send, so it needs a linked Telegram account AND
# AURA_SCHEDULER_PREFER_ORIGIN_CHANNEL left on — with the gate off it reports
# undelivered and falls back to stdout.
AURA_SCHEDULER_NOTIFY_DEFAULT=stdout
AURA_SCHEDULER_NOTIFY_RECIPIENT=
# Quiet-hours window HH:MM-HH:MM (empty = off). Non-DESTRUCTIVE notifications
# defer to the window end; reminders scheduled inside the window still fire on time.
AURA_SCHEDULER_QUIET_HOURS=
# DIY tick-loop interval (seconds).
AURA_SCHEDULER_TICK_SECONDS=30
# Held-conn concurrency cap for advisory-locked runs. Keep strictly below the
# pool MaxConns (one dedicated conn per running job, session-scoped lock).
AURA_SCHEDULER_MAX_CONCURRENT_RUNS=4
# Bounded delivery retries before falling back to stdout + marking the run
# notification-undelivered.
AURA_SCHEDULER_NOTIFY_RETRY_ATTEMPTS=3
# Prefer the identity's origin channel when a scheduled task has one.
AURA_SCHEDULER_PREFER_ORIGIN_CHANNEL=true
# Backup dump destination. In Compose this is the host bind source mounted into
# Aura and Postgres at /backups. Retention is 14d rolling. Memory is NOT dumped:
# ArcadeDB has no backup handler yet (see internal/cron/handlers/backup.go).
AURA_BACKUP_DIR=./backups
