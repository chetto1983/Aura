# Aura — minimal environment file
#
# Most configuration now lives in the dashboard's Settings page, persisted
# to aura.db. The values below are the bootstrap-only fields that must be
# present BEFORE the bot can start.
#
# First-run flow:
#   1. Leave TELEGRAM_TOKEN blank.
#   2. Run aura — it boots a setup wizard at http://127.0.0.1:8080.
#   3. Open the URL, paste your bot token, pick an LLM provider, save.
#   4. The wizard writes TELEGRAM_TOKEN here and the rest to aura.db.
#
# After setup, edit anything from the dashboard's Settings page —
# no restart needed for most fields.

# Required after first-run setup (or paste here manually).
TELEGRAM_TOKEN=

# Where the dashboard listens. 127.0.0.1 is loopback-only (recommended).
# Set 0.0.0.0:8080 to expose on your LAN — bearer auth still required.
HTTP_PORT=127.0.0.1:8080

# Server/container mode disables the Windows tray and waits for SIGINT/SIGTERM.
# Keep false for normal desktop releases; compose.yaml overrides it to true.
AURA_HEADLESS=false

# Bootstrap env file location. Desktop runs use .env; containers override this
# to /data/.env so first-run setup survives rebuilds and recreates.
AURA_ENV_PATH=.env

# SQLite file holding settings, conversations, tasks, auth tokens, and
# the embedding cache. One file = one backup artifact.
DB_PATH=./aura.db

# Filesystem roots. These stay in env because the running process
# already has them open.
WIKI_PATH=./wiki
SKILLS_PATH=./skills
MCP_SERVERS_PATH=./mcp.json
PROMPT_OVERLAY_PATH=.

# Log verbosity: debug | info | warn | error.
LOG_LEVEL=info

# ─── Advanced (rarely changed) ─────────────────────────────────────
# Everything below has a sensible default. Edit from the dashboard
# Settings page; only set here if you need a value before first boot.
#
# TELEGRAM_ALLOWLIST=
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# OpenRouter example: LLM_BASE_URL=https://openrouter.ai/api/v1 and LLM_MODEL=deepseek/deepseek-chat
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=
# WEB_SEARCH_PROVIDER=disabled
# SEARXNG_BASE_URL=http://127.0.0.1:8088
# GARAGE_S3_ENDPOINT=http://127.0.0.1:3900
# GARAGE_S3_REGION=garage
# GARAGE_S3_BUCKET=aura-artifacts
# GARAGE_S3_ACCESS_KEY=
# GARAGE_S3_SECRET_KEY=
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_COLLECTION=aura_memory_v1
# QDRANT_API_KEY=
# SEARCH_BACKEND=chromem
# SPECULATIVE_SEARCH_TIMEOUT_MS=1500
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.mistral.ai/v1
# EMBEDDING_MODEL=mistral-embed
# MISTRAL_API_KEY=
# OCR_ENABLED=true
# SOFT_BUDGET=10.0
# HARD_BUDGET=20.0
# USD per 1M tokens. Use the selected provider/model pricing.
# COST_INPUT_PER_M_TOKENS=0.20
# COST_OUTPUT_PER_M_TOKENS=0.80
# MAX_CONTEXT_TOKENS=125000
# MAX_HISTORY_MESSAGES=50
# MAX_TOOL_ITERATIONS=10
# AURA_PROMPT_VERSION=aura-agent-v1
# AURA_TOOL_PROFILE_MODE=auto
# AURA_ORCHESTRATION_LOG_LEVEL=summary
# DASHBOARD_TOKEN_TTL_HOURS=720
# SUMMARIZER_MODE=off
# SKILLS_ADMIN=false
# AURABOT_ENABLED=false
# AURABOT_MAX_ACTIVE=4
# AURABOT_MAX_DEPTH=1
# AURABOT_TIMEOUT_SEC=300
# AURABOT_MAX_ITERATIONS=5
# OTEL_ENABLED=false
# CONV_ARCHIVE_ENABLED=true

# ─── Sandbox (bundled Pyodide) ───────────────────────────────────────
# Release builds should ship the sandbox runtime inside runtime/pyodide/.
# There is no host-Python fallback; missing or unhealthy bundles disable
# execute_code and surface sandbox health in the dashboard.
# SANDBOX_ENABLED=true
# SANDBOX_RUNTIME_DIR=./runtime/pyodide
# SANDBOX_TIMEOUT_SEC=120

# ─── E2E (Playwright) ──────────────────────────────────────────────
# Mint AURA_E2E_TOKEN once via the request_dashboard_token Telegram tool.
AURA_DASHBOARD_URL=http://localhost:8080
AURA_E2E_TOKEN=
AURA_E2E_CHAT_ID=
