# `:443` + on-demand internal-CA TLS so a LAN client reaches the wizard by any
# IP/hostname (a `localhost:443` site only served the localhost SNI). On-demand
# has no rate limit (Caddy removed `rate_limit`; only `ask`/`permission` remain),
# but the abuse surface is low and accepted for this appliance: Caddy is the sole
# LAN-published port, all data ports are loopback-only, content is token-gated,
# and the issuer is a local internal CA (no external ACME). An attacker must
# already be on the LAN; worst case is local internal-cert churn. Revisit with an
# `ask` endpoint if Aura is ever exposed beyond a trusted LAN.
:443 {
	tls internal {
		on_demand
	}

	@authed `header({'X-Aura-Token': '{$AURA_ACCESS_TOKEN}'}) || query({'token': '{$AURA_ACCESS_TOKEN}'})`
	@agui path /agent/* /threads/* /healthz /readyz /debug/vars /metrics
	@setup path /setup /setup/*

	# Google OAuth redirect callback: after consent Google sends the operator's browser
	# here with ?code&state and NO Aura token, so it is exempt from @authed and proxies
	# straight to the PIM calendar sidecar, which exchanges the code and renders a result
	# page. The cockpit polls /admin/accounts/{id}/status for the linked state. The OAuth
	# state binds the exchange, so an unauthenticated callback path is the standard,
	# low-risk shape. Set AURA_PIM_EXTERNAL_BASE_URL so the sidecar builds this exact
	# https://<host>/admin/auth/google/callback redirect URI (register it in the Google client).
	handle /admin/auth/google/callback {
		reverse_proxy aura-pim-mcp:8080
	}

	handle @authed {
		handle @agui {
			reverse_proxy aura:9080
		}

		handle @setup {
			reverse_proxy aura:9081
		}

		respond 404
	}

	respond 401
}
