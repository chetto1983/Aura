# Appliance Caddyfile — fronts the FULL multi-user cockpit on aura:9080 so an end user
# just opens https://<host> and gets the Authula login page. No proxy-level token.
#
# `:443` + on-demand internal-CA TLS so a LAN client reaches the cockpit by any
# IP/hostname (a `localhost:443` site only served the localhost SNI). On-demand has no
# rate limit (Caddy removed `rate_limit`; only `ask`/`permission` remain), but the abuse
# surface is low and accepted for this appliance: Caddy is the sole LAN-published port,
# all data ports are loopback-only, and the issuer is a local internal CA (no external
# ACME). An attacker must already be on the LAN; worst case is local internal-cert churn.
#
# Auth is handled IN the aura binary by RequireAuth (Authula), NOT by a proxy token: an
# unauthenticated browser navigation (Accept: text/html) is 302-redirected to /login (a
# public page); /auth/*, /api/auth/config and the login static assets are public; every
# other route redirects/401s until a session cookie exists. Fronting 9080 in full is the
# correct multi-user posture (compose WEB-02: the 9080 bind is permitted because Authula
# is configured). The earlier token-gated proxy never exposed the cockpit SPA or the
# Authula login — only the AG-UI API + the 9081 setup wizard — so an end user could not
# reach a login page at all.
:443 {
	tls internal {
		on_demand
	}

	# Google OAuth redirect callback → PIM calendar sidecar. Unauthenticated by design
	# (Google sends the browser here with ?code&state and no Aura session; the OAuth state
	# binds the exchange). Register AURA_PIM_EXTERNAL_BASE_URL as https://<host> so the
	# sidecar builds this exact /admin/auth/google/callback redirect URI. Ahead of the catch-all.
	handle /admin/auth/google/callback {
		reverse_proxy aura-pim-mcp:8080
	}

	# Presigned object-store downloads (chat/document assets) → garage.
	handle /aura-assets/* {
		reverse_proxy garage:3900
	}

	# First-run operator setup wizard (the 9081 server gates itself with AURA_SETUP_TOKEN).
	handle /setup {
		reverse_proxy aura:9081
	}
	handle /setup/* {
		reverse_proxy aura:9081
	}

	# Everything else → the full cockpit + Authula login on 9080.
	reverse_proxy aura:9080
}

# The MCP Apps sandbox origin (SEP-1865). A view is HTML a mounted MCP server
# wrote, and it needs `allow-same-origin` to run at all — so the origin it gets
# must be one where the operator has no session. A second PORT is a different
# origin to a browser, which is what the sandbox check in
# internal/agui/mcp_views_api.go requires, and it needs no second DNS name.
#
# It is deliberately a keyhole: exactly one path, the relay document, which holds
# no data of its own. Everything else 404s here so this port can never become a
# second door to the cockpit.
#
# A separate HOSTNAME would be stronger still, because cookies are scoped by host
# and IGNORE the port: the session cookie for https://<host> IS sent to
# https://<host>:8444. Aura compensates by refusing to grant a view any declared
# domain pointing back at its own host (mcp.ViewPolicy.WithoutHost), and the relay
# itself is served under `default-src 'none'` so it can fetch nothing regardless.
# An operator with DNS to spare should still prefer a distinct name.
:8444 {
	tls internal {
		on_demand
	}

	handle /mcp-sandbox {
		reverse_proxy aura:9080
	}

	handle {
		respond 404
	}
}
